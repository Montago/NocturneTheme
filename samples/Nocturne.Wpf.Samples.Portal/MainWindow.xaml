<nc:NocturneWindow x:Class="Nocturne.Wpf.Samples.Portal.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:nc="urn:nocturne-wpf"
                   xmlns:v="clr-namespace:Nocturne.Wpf.Samples.Portal.Views"
                   Title="Northwind Traders · Sales portal"
                   Width="1280" Height="800" MinWidth="960" MinHeight="600"
                   WindowStartupLocation="CenterScreen">
    <nc:NocturneWindow.Resources>
        <!-- One side bar entry: the page name in Content, its icon in Tag -->
        <DataTemplate x:Key="NavigationEntry">
            <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                    <nc:StrokeIcon Width="18" Height="18" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </ContentControl>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </nc:NocturneWindow.Resources>

    <!-- Pages ask for navigation with NavigationCommands.GoToPage and the page name as parameter -->
    <nc:NocturneWindow.CommandBindings>
        <CommandBinding Command="NavigationCommands.GoToPage" Executed="OnGoToPage" />
    </nc:NocturneWindow.CommandBindings>

    <nc:NocturneWindow.RightWindowCommands>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Nocturne.Styles.Button.Subtle}" ToolTip="Signed in" Padding="10,0">
                <StackPanel Orientation="Horizontal">
                    <nc:StrokeIcon Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Sample.Icons.User}" />
                    <TextBlock VerticalAlignment="Center" Text="Lindsey Ballard" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Nocturne.Styles.Button.Icon.Subtle}" Margin="6,0,0,0" ToolTip="Help" AutomationProperties.Name="Help"
                    Command="NavigationCommands.GoToPage" CommandParameter="About">
                <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Sample.Icons.Help}" />
            </Button>
        </StackPanel>
    </nc:NocturneWindow.RightWindowCommands>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <Separator />
            <StatusBarItem Content="Price list 2026 · USD" />
            <StatusBarItem HorizontalAlignment="Right" Content="Last synced 09:42" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The side bar: the company, the pages and a note at the bottom -->
            <DockPanel Margin="16,8,8,20">
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,20">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Northwind" />
                    <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Eyebrow}" Margin="0,2,0,0" Text="TRADERS · SALES" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Nocturne.Styles.Border.Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Monthly target" />
                        <ProgressBar Margin="0,10,0,8" Value="84" />
                        <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Caption}" Text="$8,413 of $10,000" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="Navigation" Style="{StaticResource Nocturne.Styles.ListBox.Navigation}" SelectedIndex="0"
                         SelectionChanged="OnNavigationChanged" AutomationProperties.Name="Pages">
                    <!-- The items are ListBoxItems themselves, so they take the entry template from their style -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Nocturne.Styles.ListBoxItem.Navigation}">
                            <Setter Property="ContentTemplate" Value="{StaticResource NavigationEntry}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Home" Tag="{StaticResource Sample.Icons.Home}" AutomationProperties.Name="Home" />
                    <ListBoxItem Content="Products" Tag="{StaticResource Sample.Icons.Box}" AutomationProperties.Name="Products" />
                    <ListBoxItem Content="Orders" Tag="{StaticResource Sample.Icons.List}" AutomationProperties.Name="Orders" />
                    <ListBoxItem Content="Customers" Tag="{StaticResource Sample.Icons.People}" AutomationProperties.Name="Customers" />
                    <ListBoxItem Content="About" Tag="{StaticResource Sample.Icons.Help}" AutomationProperties.Name="About" />
                </ListBox>
            </DockPanel>

            <!-- The pages, in the order of the side bar; the selected one is shown -->
            <Grid x:Name="Pages" Grid.Column="1">
                <v:HomeView />
                <v:ProductsView />
                <v:OrdersView />
                <v:CustomersView />
                <v:AboutView />
            </Grid>
        </Grid>
    </DockPanel>
</nc:NocturneWindow>
