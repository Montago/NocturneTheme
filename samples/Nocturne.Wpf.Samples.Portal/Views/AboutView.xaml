<UserControl x:Class="Nocturne.Wpf.Samples.Portal.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20,12,28,24" MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource Page.Title}" Text="About" />
        <TextBlock Style="{StaticResource Page.Intro}" Text="Northwind Traders sales portal" />

        <HeaderedContentControl Style="{StaticResource Nocturne.Styles.Card}" Header="THIS SAMPLE">
            <StackPanel>
                <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="A sample application for Nocturne for WPF: a side bar with one entry per page, cards on the pages and a status bar at the bottom." />
                <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Body}" TextWrapping="Wrap" Margin="0,0,0,18"
                           Text="Every page is a UserControl in Views/ with fixed sample data, so the layout and the controls can be read without any back end." />
                <TextBlock Margin="0,0,0,6">
                    <Hyperlink NavigateUri="https://github.com/Montago/NocturneTheme" RequestNavigate="OnRequestNavigate">Nocturne for WPF on GitHub</Hyperlink>
                </TextBlock>
                <TextBlock Text="Built with Nocturne WPF" Style="{StaticResource Nocturne.Styles.TextBlock.Caption}" />
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
