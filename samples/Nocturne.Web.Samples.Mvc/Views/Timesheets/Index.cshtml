@model TimesheetsPage
@{
    ViewData["Title"] = "Timesheets";
    string Pill(string status) => status switch
    {
        "Submitted" => "nc-pill nc-pill--warning",
        "Approved" => "nc-pill nc-pill--success",
        "Rejected" => "nc-pill nc-pill--error",
        _ => "nc-tag",
    };
    var all = SampleData.Timesheet;
    var total = all.Sum(r => r.Total);
    var approved = all.Where(r => r.Status == "Approved").Sum(r => r.Total);
}

<h1 class="nc-text-block--title">Timesheets</h1>
<p class="nc-text-block--caption mt-1 mb-4">Approve the hours of the week</p>

<form method="get" class="flex flex-wrap items-center gap-2.5 mb-4" data-auto-submit>
    <select class="nc-combo-box w-[190px]" name="week" aria-label="Week">
        @foreach (var w in SampleData.Weeks)
        {
            <option selected="@(w == Model.Week)">@w</option>
        }
    </select>
    <select class="nc-combo-box w-[130px]" name="status" aria-label="Status">
        @foreach (var s in FilterLists.Statuses)
        {
            <option selected="@(s == Model.Status)">@s</option>
        }
    </select>

    <div class="ml-auto flex gap-2.5">
        @* SplitButton: the main action plus a menu *@
        <div class="nc-split-button nc-split-button--primary">
            <button type="button" class="nc-split-button__main">Approve selected</button>
            <button type="button" class="nc-split-button__arrow" popovertarget="approve-menu" aria-label="More approval actions" tabindex="-1"><i class="nc-caret"></i></button>
        </div>
        <div class="nc-context-menu" popover id="approve-menu" data-nc-align="right">
            <button type="button" class="nc-menu-item">Approve all submitted</button>
            <button type="button" class="nc-menu-item">Reject selected…</button>
            <hr class="nc-menu-separator" />
            <button type="button" class="nc-menu-item">Send reminder to drafts</button>
        </div>

        @* DropDownButton *@
        <span class="nc-drop-down-button"><button type="button" class="nc-button" popovertarget="export-menu">Export <i class="nc-caret"></i></button></span>
        <div class="nc-context-menu" popover id="export-menu" data-nc-align="right">
            <button type="button" class="nc-menu-item">Payroll file (.csv)</button>
            <button type="button" class="nc-menu-item">Excel (.xlsx)</button>
            <button type="button" class="nc-menu-item">PDF report</button>
        </div>
    </div>
</form>

<div class="nc-data-grid-host">
    <table class="nc-data-grid min-w-[760px]">
        <thead>
            <tr>
                <th class="w-[150px]" aria-sort="ascending">Employee</th>
                <th>Project</th>
                <th class="w-[52px] text-right">Mon</th>
                <th class="w-[52px] text-right">Tue</th>
                <th class="w-[52px] text-right">Wed</th>
                <th class="w-[52px] text-right">Thu</th>
                <th class="w-[52px] text-right">Fri</th>
                <th class="w-[60px] text-right">Total</th>
                <th class="w-[110px]">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Employee</td>
                    <td>@r.Project</td>
                    <td class="nc-data-grid__number">@r.Monday.ToString("N1")</td>
                    <td class="nc-data-grid__number">@r.Tuesday.ToString("N1")</td>
                    <td class="nc-data-grid__number">@r.Wednesday.ToString("N1")</td>
                    <td class="nc-data-grid__number">@r.Thursday.ToString("N1")</td>
                    <td class="nc-data-grid__number">@r.Friday.ToString("N1")</td>
                    <td class="nc-data-grid__number font-semibold">@r.Total.ToString("N1")</td>
                    <td><span class="@Pill(r.Status)">@r.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Week summary *@
<div class="flex flex-wrap items-center gap-3 mt-4">
    <span class="nc-text-block--caption">Approved this week</span>
    <progress class="nc-progress-bar w-[200px]" max="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)" value="@approved.ToString(System.Globalization.CultureInfo.InvariantCulture)"></progress>
    <span class="nc-text-block--caption">@approved.ToString("N1") of @total.ToString("N1") hours · @all.Count(r => r.Status == "Submitted") timesheets submitted · @all.Count(r => r.Status == "Rejected") rejected</span>
</div>
