@model ProjectsPage
@{
    ViewData["Title"] = "Projects";
}

<h1 class="nc-text-block--title">Projects</h1>
<p class="nc-text-block--caption mt-1 mb-4">Customers and their projects</p>

<div class="grid grid-cols-1 md:grid-cols-[260px_minmax(0,1fr)] gap-6 items-start">
    @* TreeView: customers with their projects *@
    <ul class="nc-tree-view nc-card" style="padding:10px">
        @foreach (var c in SampleData.Customers)
        {
            <li>
                <details open>
                    <summary>
                        <a class="nc-tree-view__item" asp-route-customer="@Slug.Of(c.Name)" aria-current="@(Model.Customer == c ? "page" : null)">@c.Name</a>
                    </summary>
                    <ul>
                        @foreach (var p in c.Projects)
                        {
                            <li><a class="nc-tree-view__item" asp-route-project="@Slug.Of(p.Name)" aria-current="@(Model.Project == p ? "page" : null)">@p.Name</a></li>
                        }
                    </ul>
                </details>
            </li>
        }
    </ul>

    <div>
        @if (Model.Customer is { } customer)
        {
            <h2 class="nc-text-block--subtitle">@customer.Name</h2>
            <p class="nc-text-block--caption mt-0.5 mb-3.5">@customer.City · @customer.Projects.Count projects</p>
            <table class="nc-data-grid max-w-[560px]">
                <thead><tr><th>Project</th><th>Manager</th><th>Deadline</th></tr></thead>
                <tbody>
                    @foreach (var p in customer.Projects)
                    {
                        <tr data-href="@Url.Action("Index", new { project = Slug.Of(p.Name) })">
                            <td>@p.Name</td>
                            <td>@p.Manager</td>
                            <td data-sort-value="@p.Deadline.ToString("yyyy-MM-dd")">@p.Deadline.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (Model.Project is { } project)
        {
            <h2 class="nc-text-block--subtitle">@project.Name</h2>
            <p class="nc-text-block--caption mt-0.5 mb-3.5">@project.Customer · managed by @project.Manager</p>

            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_220px] gap-5 items-start">
                <nc-card header="Budget" tag="Hours">
                    <div class="flex justify-between">
                        <span class="font-semibold">Hours used</span>
                        <span class="nc-text-block--caption">@project.UsedHours of @project.BudgetHours hours</span>
                    </div>
                    <progress class="nc-progress-bar mt-2 mb-4" max="100" value="@project.Progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"></progress>
                    <div class="grid grid-cols-[110px_1fr] auto-rows-[30px] items-center">
                        <span class="nc-text-block--caption">Deadline</span>
                        <span>@project.Deadline.ToLongDateString()</span>
                        <span class="nc-text-block--caption">Satisfaction</span>
                        <span class="nc-rating" style="--value: @project.Satisfaction; --max: 5" role="img" aria-label="@project.Satisfaction of 5"></span>
                    </div>
                </nc-card>

                <nc-card header="Team">
                    @foreach (var member in project.Team)
                    {
                        <div class="mt-0.5 mb-1">@member</div>
                    }
                </nc-card>
            </div>

            <details class="nc-expander mt-4" open>
                <summary>Notes</summary>
                <div class="nc-expander__content">@project.Notes</div>
            </details>
        }
    </div>
</div>
