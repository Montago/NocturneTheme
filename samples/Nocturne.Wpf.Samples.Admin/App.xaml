<Application x:Class="Nocturne.Wpf.Samples.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nc="urn:nocturne-wpf"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nocturne.Wpf;component/Styles/Nocturne.xaml" />
                <ResourceDictionary Source="SampleIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by the pages in Views/ -->
            <Style x:Key="Page.Title" TargetType="TextBlock" BasedOn="{StaticResource Nocturne.Styles.TextBlock.Title}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="Page.Intro" TargetType="TextBlock" BasedOn="{StaticResource Nocturne.Styles.TextBlock.Caption}">
                <Setter Property="Margin" Value="0,0,0,18" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Page.Toolbar" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="LastChildFill" Value="False" />
            </Style>
            <Style x:Key="Page.Caption" TargetType="TextBlock" BasedOn="{StaticResource Nocturne.Styles.TextBlock.Caption}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
