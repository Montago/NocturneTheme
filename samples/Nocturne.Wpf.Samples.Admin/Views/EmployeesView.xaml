<UserControl x:Class="Nocturne.Wpf.Samples.Admin.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nc="urn:nocturne-wpf"
             xmlns:local="clr-namespace:Nocturne.Wpf.Samples.Admin">
    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Page.Title}" Text="Employees" />
        <TextBlock x:Name="Count" Grid.Row="1" Style="{StaticResource Page.Intro}" />

        <!-- The search on the left, actions on the right; the column headers filter by department and status -->
        <DockPanel Grid.Row="2" Style="{StaticResource Page.Toolbar}">
            <TextBox x:Name="Search" Width="260" Style="{StaticResource Nocturne.Styles.TextBox.Search}"
                     nc:ControlHelper.Placeholder="Search employees" nc:ControlHelper.ClearButton="True"
                     AutomationProperties.Name="Search employees" />

            <Button DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.Button.Primary}" Content="New employee" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Click="OnDelete" AutomationProperties.Name="Delete">
                <StackPanel Orientation="Horizontal">
                    <nc:StrokeIcon Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource Nocturne.Icons.Delete}" />
                    <TextBlock Text="Delete" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <nc:NocturneGrid x:Name="List" IsReadOnly="True" SelectionMode="Single"
                             SearchText="{Binding Text, ElementName=Search}" Filtered="OnFiltered">
                <nc:NocturneGrid.Columns>
                    <nc:NocturneGridColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                    <nc:NocturneGridColumn Header="TITLE" Binding="{Binding Title}" Width="150" />
                    <nc:NocturneGridColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="130" />
                    <nc:NocturneGridColumn Header="STARTED" Binding="{Binding StartDate, StringFormat=d}" Width="110" TextAlignment="Right" IsSearchable="False" />
                    <nc:NocturneGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="90" />
                </nc:NocturneGrid.Columns>
            </nc:NocturneGrid>

            <!-- The details follow the selected row -->
            <HeaderedContentControl Grid.Column="2" Style="{StaticResource Nocturne.Styles.Card}" Header="DETAILS" VerticalAlignment="Top"
                                    DataContext="{Binding SelectedItem, ElementName=List}">
                <StackPanel>
                    <nc:InfoBar x:Name="Saved" Severity="Success" Title="Saved." Message="The changes are stored." IsOpen="False" Margin="0,0,0,12" />

                    <Label Content="_Name" Target="{Binding ElementName=NameBox}" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, Mode=OneWay}" />
                    <Label Margin="0,12,0,0" Content="_Title" Target="{Binding ElementName=TitleBox}" />
                    <TextBox x:Name="TitleBox" Text="{Binding Title, Mode=OneWay}" />
                    <Label Margin="0,12,0,0" Content="_Department" Target="{Binding ElementName=DepartmentBox}" />
                    <ComboBox x:Name="DepartmentBox" ItemsSource="{x:Static local:SampleData.Departments}" SelectedItem="{Binding Department, Mode=OneWay}" />
                    <Label Margin="0,12,0,0" Content="_Email" Target="{Binding ElementName=EmailBox}" />
                    <TextBox x:Name="EmailBox" Text="{Binding Email, Mode=OneWay}" />

                    <!-- Short values side by side -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="_Start date" Target="{Binding ElementName=StartBox}" />
                            <DatePicker x:Name="StartBox" SelectedDateFormat="Short" SelectedDate="{Binding StartDate, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Hours a week" Target="{Binding ElementName=HoursBox}" />
                            <nc:NumericUpDown x:Name="HoursBox" Value="{Binding HoursPerWeek, Mode=OneWay}" Minimum="0" Maximum="40" Interval="0.5" StringFormat="N1" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Style="{StaticResource Nocturne.Styles.ToggleSwitch}" Margin="0,16,0,0" Content="Active" IsChecked="{Binding IsActive, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" MinWidth="80" />
                        <Button Style="{StaticResource Nocturne.Styles.Button.Primary}" Content="Save" MinWidth="80" Margin="8,0,0,0" Click="OnSave" />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
