<UserControl x:Class="Nocturne.Wpf.Samples.Admin.Views.TimesheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nc="urn:nocturne-wpf"
             xmlns:local="clr-namespace:Nocturne.Wpf.Samples.Admin">
    <UserControl.Resources>
        <ContextMenu x:Key="ApproveMenu">
            <MenuItem Header="Approve all submitted" nc:ControlHelper.Icon="{StaticResource Nocturne.Icons.CheckCircle}" />
            <MenuItem Header="Reject selected…" />
            <Separator />
            <MenuItem Header="Send reminder to drafts" />
        </ContextMenu>
        <ContextMenu x:Key="ExportMenu">
            <MenuItem Header="Payroll file (.csv)" />
            <MenuItem Header="Excel (.xlsx)" />
            <MenuItem Header="PDF report" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Page.Title}" Text="Timesheets" />
        <TextBlock Grid.Row="1" Style="{StaticResource Page.Intro}" Text="Hours by employee and project. Filter the status in its column header." />

        <DockPanel Grid.Row="2" Style="{StaticResource Page.Toolbar}">
            <ComboBox Width="210" SelectedIndex="0" ItemsSource="{x:Static local:SampleData.Weeks}" AutomationProperties.Name="Week" />

            <nc:SplitButton DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.SplitButton.Primary}" Content="Approve selected"
                            Menu="{StaticResource ApproveMenu}" Margin="8,0,0,0" />
            <nc:DropDownButton DockPanel.Dock="Right" Content="Export" Menu="{StaticResource ExportMenu}" />
        </DockPanel>

        <!-- One group of rows per employee -->
        <nc:NocturneGrid Grid.Row="3" IsReadOnly="True" SelectionMode="Extended" GroupMemberPath="Employee"
                         ItemsSource="{x:Static local:SampleData.Timesheet}">
            <nc:NocturneGrid.Columns>
                <nc:NocturneGridColumn Header="PROJECT" Binding="{Binding Project}" Width="*" />
                <nc:NocturneGridColumn Header="MON" Binding="{Binding Monday, StringFormat=N1}" Width="74" TextAlignment="Right" />
                <nc:NocturneGridColumn Header="TUE" Binding="{Binding Tuesday, StringFormat=N1}" Width="74" TextAlignment="Right" />
                <nc:NocturneGridColumn Header="WED" Binding="{Binding Wednesday, StringFormat=N1}" Width="74" TextAlignment="Right" />
                <nc:NocturneGridColumn Header="THU" Binding="{Binding Thursday, StringFormat=N1}" Width="74" TextAlignment="Right" />
                <nc:NocturneGridColumn Header="FRI" Binding="{Binding Friday, StringFormat=N1}" Width="74" TextAlignment="Right" />
                <nc:NocturneGridColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N1}" Width="84" TextAlignment="Right" FontWeight="SemiBold" />
                <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="local:TimesheetRow">
                            <ContentControl x:Name="Status" Style="{StaticResource Nocturne.Styles.Tag}" Content="{Binding Status}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                    <Setter TargetName="Status" Property="Style" Value="{StaticResource Nocturne.Styles.Pill.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                    <Setter TargetName="Status" Property="Style" Value="{StaticResource Nocturne.Styles.Pill.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                    <Setter TargetName="Status" Property="Style" Value="{StaticResource Nocturne.Styles.Pill.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </nc:NocturneGrid.Columns>
        </nc:NocturneGrid>

        <!-- Week summary -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Page.Caption}" Text="Approved this week" Margin="0,0,12,0" />
            <ProgressBar Width="220" Value="38" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Page.Caption}" Margin="12,0,0,0" Text="112.5 of 296 hours · 4 timesheets submitted · 1 rejected" />
        </StackPanel>
    </Grid>
</UserControl>
