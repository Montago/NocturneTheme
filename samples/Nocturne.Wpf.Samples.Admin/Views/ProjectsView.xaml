<UserControl x:Class="Nocturne.Wpf.Samples.Admin.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nc="urn:nocturne-wpf"
             xmlns:local="clr-namespace:Nocturne.Wpf.Samples.Admin">
    <UserControl.Resources>
        <!-- The right-hand side shows whatever is selected in the tree: a customer or a project -->
        <DataTemplate DataType="{x:Type local:Customer}">
            <StackPanel>
                <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Subtitle}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Page.Caption}" Margin="0,2,0,16">
                    <Run Text="{Binding City, Mode=OneWay}" /> · <Run Text="{Binding Projects.Count, Mode=OneWay}" /> projects
                </TextBlock>
                <ListView ItemsSource="{Binding Projects}" Height="180">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="PROJECT" DisplayMemberBinding="{Binding Name}" Width="220" />
                            <GridViewColumn Header="MANAGER" DisplayMemberBinding="{Binding Manager}" Width="170" />
                            <GridViewColumn Header="DEADLINE" DisplayMemberBinding="{Binding Deadline, StringFormat=d}" Width="120" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:Project}">
            <StackPanel>
                <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Subtitle}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Page.Caption}" Margin="0,2,0,16">
                    <Run Text="{Binding Customer, Mode=OneWay}" /> · managed by <Run Text="{Binding Manager, Mode=OneWay}" />
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <HeaderedContentControl Style="{StaticResource Nocturne.Styles.Card}" Header="BUDGET">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Page.Caption}">
                                    <Run Text="{Binding UsedHours, Mode=OneWay}" /> of <Run Text="{Binding BudgetHours, Mode=OneWay}" /> hours
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold" Text="Hours used" />
                            </DockPanel>
                            <ProgressBar Margin="0,10,0,18" Value="{Binding Progress, Mode=OneWay}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Page.Caption}" Text="Deadline" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Deadline, StringFormat=D}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Page.Caption}" Text="Satisfaction" />
                                <nc:Rating Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" IsReadOnly="True"
                                           Value="{Binding Satisfaction, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="2" Style="{StaticResource Nocturne.Styles.Card}" Header="TEAM">
                        <ItemsControl ItemsSource="{Binding Team}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Sample.Icons.User}" />
                                        </ContentControl>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </HeaderedContentControl>
                </Grid>

                <Expander Header="Notes" IsExpanded="True" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Text="{Binding Notes}" />
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Page.Title}" Text="Projects" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Page.Intro}" Text="5 projects for 3 customers" />

        <TreeView x:Name="Tree" Grid.Row="2" ItemsSource="{x:Static local:SampleData.Customers}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:Customer}" ItemsSource="{Binding Projects}">
                    <TextBlock Text="{Binding Name}" />
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Project}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Focusable="False" Content="{Binding SelectedItem, ElementName=Tree}" />
        </ScrollViewer>
    </Grid>
</UserControl>
