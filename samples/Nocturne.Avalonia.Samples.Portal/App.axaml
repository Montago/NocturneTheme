<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nc="urn:nocturne-avalonia"
             x:Class="Nocturne.Avalonia.Samples.Portal.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/SampleIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <nc:NocturneTheme />
        <!-- Shared by the pages in Views/ -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.pageIntro">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="DockPanel.pageToolbar">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGridCell.right">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Application.Styles>
</Application>
