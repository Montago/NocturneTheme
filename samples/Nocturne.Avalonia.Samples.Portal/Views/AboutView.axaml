<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nocturne.Avalonia.Samples.Portal.Views.AboutView">
    <StackPanel Margin="20,12,28,24" MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Theme="{StaticResource Nocturne.Styles.TextBlock.Title}" Classes="pageTitle" Text="About" />
        <TextBlock Theme="{StaticResource Nocturne.Styles.TextBlock.Caption}" Classes="pageIntro" Text="Northwind Traders sales portal" />

        <HeaderedContentControl Theme="{StaticResource Nocturne.Styles.Card}" Header="THIS SAMPLE">
            <StackPanel>
                <TextBlock Theme="{StaticResource Nocturne.Styles.TextBlock.Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="A sample application for Nocturne for Avalonia: a side bar with one entry per page, cards on the pages and a status bar at the bottom." />
                <TextBlock Theme="{StaticResource Nocturne.Styles.TextBlock.Body}" TextWrapping="Wrap" Margin="0,0,0,18"
                           Text="Every page is a UserControl in Views/ with fixed sample data, so the layout and the controls can be read without any back end. It runs on Windows, macOS and Linux." />
                <HyperlinkButton Margin="0,0,0,6" Padding="0" Content="Nocturne on GitHub" NavigateUri="https://github.com/Montago/NocturneTheme" />
                <TextBlock Name="Version" Theme="{StaticResource Nocturne.Styles.TextBlock.Caption}" />
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
