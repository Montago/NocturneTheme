<!--
    NocturneDialog and Flyout: the glass surfaces that sit over the page. Both use the popup surface
    (Nocturne.Brushes.Popup) with a 14px radius and a soft shadow.
    A dialog is centred over the dimmed page and grows in from 96 % in 150 ms; its main button is
    primary, the second one plain. A flyout floats 12px from the edge it slides in from.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Nocturne.Avalonia.Controls">

    <ControlTheme x:Key="{x:Type c:NocturneDialog}" TargetType="c:NocturneDialog">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24,22,24,24" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Card">
                    <Border Margin="1" CornerRadius="{TemplateBinding CornerRadius}" Background="Black" BoxShadow="0 16 40 0 #80000000" />
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <Border CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Nocturne.Brushes.Surface1.Highlight}" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Nocturne.Font.Size.Subtitle}" FontWeight="SemiBold"
                                           IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Name="PART_Negative" MinWidth="96" Margin="0,0,8,0" Content="{TemplateBinding NegativeText}"
                                            IsVisible="{TemplateBinding NegativeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Button Name="PART_Affirmative" MinWidth="96" Content="{TemplateBinding AffirmativeText}" IsDefault="True" />
                                </StackPanel>
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{DynamicResource Nocturne.Brushes.Text.Label}">
                                    <ContentPresenter.DataTemplates>
                                        <!-- A plain message wraps -->
                                        <DataTemplate DataType="x:String">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21" />
                                        </DataTemplate>
                                    </ContentPresenter.DataTemplates>
                                </ContentPresenter>
                            </DockPanel>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Grows in from 96 % in 150 ms -->
        <Style Selector="^ /template/ Panel#Card">
            <Style.Animations>
                <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:Flyout}" TargetType="c:Flyout">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22,18,22,22" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Margin="1" CornerRadius="{TemplateBinding CornerRadius}" Background="Black" BoxShadow="0 8 32 0 #73000000" />
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <Border CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Nocturne.Brushes.Surface1.Highlight}" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <Button Name="PART_Close" DockPanel.Dock="Right" Width="32" Height="32" Margin="12,0,-8,0" VerticalAlignment="Center"
                                            Theme="{StaticResource Nocturne.Styles.Button.Icon.Subtle}" ToolTip.Tip="Close" AutomationProperties.Name="Close"
                                            IsVisible="{TemplateBinding IsClosable}">
                                        <c:StrokeIcon Width="16" Height="16" StrokeThickness="1.8" Data="{DynamicResource Nocturne.Icons.Close}" />
                                    </Button>
                                    <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True"
                                                      FontSize="{DynamicResource Nocturne.Font.Size.Subtitle}" FontWeight="SemiBold" />
                                </DockPanel>
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Position=Left]">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^[Position=Top]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="^[Position=Bottom]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
