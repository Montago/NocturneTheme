<!--
    GroupBox, Expander, TabControl, GridSplitter, StatusBar, InfoBar, Badged, BusyIndicator and
    Accordion. The default TabControl is a segmented control
    (tabs share a sunken strip, the selected one has a light fill and a short accent bar, which
    TabSelectionIndicator glides to a new tab). Nocturne.Styles.TabControl.Document gives
    browser-like document tabs with close buttons (TabHelper.ShowCloseButton), badges
    (TabHelper.Badge) and a "+" button (TabHelper.ShowAddButton).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Nocturne.Avalonia.Controls"
                    xmlns:h="using:Nocturne.Avalonia.Helpers"
                    xmlns:conv="using:Avalonia.Controls.Converters">

    <conv:BorderGapMaskConverter x:Key="Nocturne.Converters.BorderGapMask" />

    <!-- GroupBox: a sunken frame with the header sitting in a gap in its top edge -->
    <ControlTheme x:Key="{x:Type GroupBox}" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,6,16,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="10,Auto,*,10" RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                    <Border Name="Header" Grid.Column="1" Grid.RowSpan="2" Padding="6,0">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          RecognizesAccessKey="True" FontSize="{DynamicResource Nocturne.Font.Size.Caption}" FontWeight="SemiBold" />
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter" Grid.Row="2" Grid.ColumnSpan="4" Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border.OpacityMask>
                            <MultiBinding Converter="{StaticResource Nocturne.Converters.BorderGapMask}" ConverterParameter="10">
                                <Binding ElementName="Header" Path="Bounds.Width" />
                                <Binding RelativeSource="{RelativeSource Self}" Path="Bounds.Width" />
                                <Binding RelativeSource="{RelativeSource Self}" Path="Bounds.Height" />
                            </MultiBinding>
                        </Border.OpacityMask>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Expander: a 48px glass header with a chevron that turns in 150 ms; content below it -->
    <ControlTheme x:Key="Nocturne.Styles.Expander.Header" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bg" CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Expander.Header}" />
                    <Border Name="HoverBg" CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Expander.Header.Hover}" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <DockPanel Margin="14,0">
                        <c:StrokeIcon Name="Chevron" DockPanel.Dock="Right" Width="16" Height="16" StrokeThickness="1.8"
                                      Data="{DynamicResource Nocturne.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" RenderTransform="rotate(0deg)">
                            <c:StrokeIcon.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                </Transitions>
                            </c:StrokeIcon.Transitions>
                        </c:StrokeIcon>
                        <ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </DockPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#HoverBg">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ c|StrokeIcon#Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Padding" Value="14,14,14,4" />
        <Setter Property="ContentTransition" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="Root">
                    <ToggleButton Name="PART_toggle" DockPanel.Dock="Top" Theme="{StaticResource Nocturne.Styles.Expander.Header}"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      IsVisible="{TemplateBinding IsExpanded}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled /template/ DockPanel#Root">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
    </ControlTheme>

    <!--
        Segmented TabControl. The header's font and colour sit on the header presenter, not on the
        TabItem, so the page content does not inherit them. Under a TabSelectionIndicator the tab
        leaves out its own pill and stripe.
    -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root" Background="Transparent" Height="36">
                    <Border Name="HoverBg" CornerRadius="8" Background="{DynamicResource Nocturne.Brushes.Item.Hover}" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Border Name="SelectedBg" CornerRadius="8" Background="{DynamicResource Nocturne.Brushes.Item.Selected}">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="!(c:TabSelectionIndicator.DrawsSelection)" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter" Margin="14,0" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      FontSize="{DynamicResource Nocturne.Font.Size.Default}" FontWeight="SemiBold"
                                      Foreground="{DynamicResource Nocturne.Brushes.Tab.Text}" />
                    <Border Name="Indicator" Width="16" Height="3" Margin="0,0,0,3" CornerRadius="1.5" VerticalAlignment="Bottom"
                            Background="{DynamicResource Nocturne.Brushes.Accent.Light}">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="!(c:TabSelectionIndicator.DrawsSelection)" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#HoverBg">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Border#HoverBg">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Selected}" />
        </Style>
        <Style Selector="^:disabled /template/ Panel#Root">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Padding" Value="4,16,4,2" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <Border DockPanel.Dock="Top" CornerRadius="10" Padding="2,4" Background="{DynamicResource Nocturne.Brushes.TabStrip}"
                            BorderBrush="{DynamicResource Nocturne.Brushes.TabStrip.Border}" BorderThickness="1">
                        <Panel>
                            <!-- Draws the selected tab's pill and stripe and glides them to a new tab -->
                            <c:TabSelectionIndicator PillBrush="{DynamicResource Nocturne.Brushes.Item.Selected}" StripeBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </Border>
                    <Panel Margin="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_SelectedContentHost2" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
                        <ContentPresenter Name="PART_SelectedContentHost" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Document tabs: browser-like tabs on a panel, with close buttons (TabHelper.ShowCloseButton),
         badges (TabHelper.Badge) and a "+" button (TabHelper.ShowAddButton) -->
    <ControlTheme x:Key="Nocturne.Styles.TabItem.CloseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="6" Background="Transparent">
                    <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.Close}"
                                  Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Row.Selected}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Pressed}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Nocturne.Styles.TabItem.Document" TargetType="TabItem">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root" Height="36" Background="Transparent">
                    <Border Name="Bg" CornerRadius="8,8,0,0" Background="Transparent" />
                    <Border Name="Line" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Nocturne.Brushes.Stroke}" />
                    <Border Name="Frame" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Nocturne.Brushes.Stroke}" IsVisible="False" />
                    <Rectangle Name="Separator" Width="1" Margin="0,10" HorizontalAlignment="Left" Fill="{DynamicResource Nocturne.Brushes.Stroke}" IsVisible="False" />
                    <DockPanel Name="HeaderRow" Margin="12,0" TextElement.Foreground="{DynamicResource Nocturne.Brushes.Text.Label}">
                        <!-- Its negative right margin takes back 8 of the row's 12, so a tab with a close button ends 4 from it -->
                        <Button Name="CloseButton" DockPanel.Dock="Right" Margin="4,0,-8,0" Theme="{StaticResource Nocturne.Styles.TabItem.CloseButton}"
                                IsVisible="{TemplateBinding h:TabHelper.ShowCloseButton}"
                                Command="{x:Static h:TabHelper.CloseTabCommand}" CommandParameter="{Binding $parent[TabItem]}"
                                ToolTip.Tip="Close" AutomationProperties.Name="Close" />
                        <ContentControl Name="Badge" DockPanel.Dock="Right" Margin="6,0,0,0" Theme="{StaticResource Nocturne.Styles.Badge}"
                                        Content="{TemplateBinding h:TabHelper.Badge}"
                                        IsVisible="{TemplateBinding h:TabHelper.Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FontSize="{DynamicResource Nocturne.Font.Size.Caption}" FontWeight="SemiBold" />
                    </DockPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.separator /template/ Rectangle#Separator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.DocumentTab.Hover}" />
        </Style>
        <Style Selector="^:pointerover /template/ DockPanel#HeaderRow">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Panel#Root">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="^:selected /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.DocumentTab.Selected}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Line">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:selected /template/ Border#Frame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected /template/ DockPanel#HeaderRow">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Selected}" />
        </Style>
        <Style Selector="^:disabled /template/ Panel#Root">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Nocturne.Styles.TabItem.AddButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="ToolTip.Tip" Value="New tab" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="6" Background="Transparent">
                    <c:StrokeIcon Width="16" Height="16" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.Plus}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Row.Selected}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Pressed}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Nocturne.Styles.TabControl.Document" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Padding" Value="17" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource Nocturne.Styles.TabItem.Document}" />
        <Setter Property="h:TabHelper.TracksSeparators" Value="True" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" VerticalAlignment="Bottom" />
                        <!-- The strip's bottom line stops 10px short so the panel's rounded corner can meet it -->
                        <Border Grid.Column="1" Height="36" Margin="0,0,10,0" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Stroke}">
                            <Button Name="AddButton" Margin="4,0,0,0" HorizontalAlignment="Left" Theme="{StaticResource Nocturne.Styles.TabItem.AddButton}"
                                    IsVisible="{TemplateBinding h:TabHelper.ShowAddButton}"
                                    Command="{x:Static h:TabHelper.AddTabCommand}" CommandParameter="{Binding $parent[TabControl]}"
                                    AutomationProperties.Name="New tab" />
                        </Border>
                    </Grid>
                    <c:TabPanelBorder CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.DocumentTab.Selected}"
                                      BorderBrush="{DynamicResource Nocturne.Brushes.Stroke}">
                        <Panel Margin="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" />
                            <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Panel>
                    </c:TabPanelBorder>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        GridSplitter: a hairline along the splitter with a small rounded grip in the middle; both light
        up under the pointer, and the grip turns accent while dragged. Give it a width of 8 or so;
        for one between rows, set ResizeDirection="Rows" (and a height).
    -->
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.ScrollBar.Thumb}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Divider}" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="PreviewContent">
            <Template>
                <Border Background="{DynamicResource Nocturne.Brushes.Accent.Light}" Opacity="0.5" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="Line" Width="1" HorizontalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
                    <Border Name="Grip" Width="4" Height="32" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{TemplateBinding Foreground}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[ResizeDirection=Rows] /template/ Border#Line">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[ResizeDirection=Rows] /template/ Border#Grip">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="4" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.ScrollBar.Thumb.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Stroke}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        </Style>
    </ControlTheme>

    <!--
        StatusBar: a sunken strip with a hairline on top and small secondary text. Separators are
        vertical lines; the last item fills the rest (DockPanel), so right-align it to put it at the end.
    -->
    <ControlTheme x:Key="{x:Type c:StatusBar}" TargetType="c:StatusBar">
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <DockPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The vertical line between status bar items (StatusBar gives it to its Separators) -->
    <ControlTheme x:Key="Nocturne.Styles.Separator.Vertical" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Margin" Value="4,8" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:StatusBarItem}" TargetType="c:StatusBarItem">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        InfoBar: a rounded strip tinted by its Severity, with the matching icon, a bold title before
        the message, an optional action (Content) and a close button.
    -->
    <ControlTheme x:Key="{x:Type c:InfoBar}" TargetType="c:InfoBar">
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,6,6,6" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <c:StrokeIcon Name="Icon" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="{DynamicResource Nocturne.Icons.Info}" Foreground="{DynamicResource Nocturne.Brushes.Accent.Text}" />
                        <Button Name="PART_Close" DockPanel.Dock="Right" Width="32" Height="32" Margin="4,0,0,0" VerticalAlignment="Center"
                                Theme="{StaticResource Nocturne.Styles.Button.Icon.Subtle}" ToolTip.Tip="Close" AutomationProperties.Name="Close"
                                IsVisible="{TemplateBinding IsClosable}">
                            <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.Close}" />
                        </Button>
                        <ContentPresenter Name="PART_ContentPresenter" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Margin="0,8" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="20">
                            <Run FontWeight="SemiBold" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Run Foreground="{DynamicResource Nocturne.Brushes.Text.Label}" Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Severity=Success]">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Success.Background}" />
        </Style>
        <Style Selector="^[Severity=Success] /template/ c|StrokeIcon#Icon">
            <Setter Property="Data" Value="{DynamicResource Nocturne.Icons.CheckCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Success}" />
        </Style>
        <Style Selector="^[Severity=Warning]">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Warning.Background}" />
        </Style>
        <Style Selector="^[Severity=Warning] /template/ c|StrokeIcon#Icon">
            <Setter Property="Data" Value="{DynamicResource Nocturne.Icons.Warning}" />
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Warning}" />
        </Style>
        <Style Selector="^[Severity=Error]">
            <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Error.Background}" />
        </Style>
        <Style Selector="^[Severity=Error] /template/ c|StrokeIcon#Icon">
            <Setter Property="Data" Value="{DynamicResource Nocturne.Icons.Error}" />
            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Error}" />
        </Style>
        <Style Selector="^[IsOpen=False]">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!-- Badged: an accent count on the top-right corner of its content -->
    <ControlTheme x:Key="{x:Type c:Badged}" TargetType="c:Badged">
        <!-- The badge hangs over the corner -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="BadgeBackground" Value="{DynamicResource Nocturne.Brushes.Accent}" />
        <Setter Property="BadgeForeground" Value="{DynamicResource Nocturne.Brushes.Text.OnAccent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Border MinWidth="18" Height="18" Margin="0,-7,-7,0" Padding="5,0" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{TemplateBinding BadgeBackground}" IsHitTestVisible="False"
                            IsVisible="{TemplateBinding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Badge}"
                                          FontSize="{DynamicResource Nocturne.Font.Size.Tag}" FontWeight="Bold" Foreground="{TemplateBinding BadgeForeground}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- BusyIndicator: the content blurred and dimmed under a small glass card with a progress ring -->
    <ControlTheme x:Key="{x:Type c:BusyIndicator}" TargetType="c:BusyIndicator">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsEnabled="{TemplateBinding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                    <Border CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Overlay}" IsVisible="{TemplateBinding IsBusy}" />
                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{TemplateBinding IsBusy}">
                        <Border Margin="1" CornerRadius="12" Background="Black" BoxShadow="0 8 24 0 #73000000" />
                        <Border CornerRadius="12" Padding="16,12,20,12" Background="{DynamicResource Nocturne.Brushes.Popup}"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Popup.Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <c:ProgressRing Width="22" Height="22" Margin="0,0,12,0" IsActive="{TemplateBinding IsBusy}" />
                                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding BusyContent}"
                                                  Foreground="{DynamicResource Nocturne.Brushes.Text}" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsBusy=True] /template/ Panel#Root">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </ControlTheme>

    <!-- Accordion: Expanders 6px apart; opening one closes the others, and the open one fills the height -->
    <ControlTheme x:Key="Nocturne.Styles.Expander.Accordion" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:Accordion}" TargetType="c:Accordion">
        <Setter Property="ItemContainerTheme" Value="{StaticResource Nocturne.Styles.Expander.Accordion}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <c:AccordionPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
