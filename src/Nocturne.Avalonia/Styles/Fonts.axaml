<!--
    Type: Segoe UI where it exists (Windows), then the platform's own UI font. The design's Figtree
    can be swapped in by overriding Nocturne.Fonts.Family. No fonts ship with the theme.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Nocturne.Fonts.Family">Segoe UI, .AppleSystemUIFont, Ubuntu, Cantarell, Noto Sans, DejaVu Sans</FontFamily>
    <FontFamily x:Key="Nocturne.Fonts.Family.Mono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono</FontFamily>

    <x:Double x:Key="Nocturne.Font.Size.Title">30</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Subtitle">20</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.ListTitle">16</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Default">14</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Caption">13</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Small">12</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Tag">11</x:Double>
</ResourceDictionary>
