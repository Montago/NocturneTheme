<!--
    Type: Inter, embedded in the library (fonts/inter, SIL OFL 1.1), so the theme looks the same on
    Windows, macOS and Linux; the platform's UI fonts stand behind it for characters Inter lacks.
    Apps can override Nocturne.Fonts.Family (the design used Figtree).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Nocturne.Fonts.Family">avares://Nocturne.Avalonia/Assets/Fonts#Inter, Segoe UI, .AppleSystemUIFont, Ubuntu, Cantarell, Noto Sans, DejaVu Sans</FontFamily>
    <FontFamily x:Key="Nocturne.Fonts.Family.Mono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono</FontFamily>

    <x:Double x:Key="Nocturne.Font.Size.Title">30</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Subtitle">20</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.ListTitle">16</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Default">14</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Caption">13</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Small">12</x:Double>
    <x:Double x:Key="Nocturne.Font.Size.Tag">11</x:Double>
</ResourceDictionary>
