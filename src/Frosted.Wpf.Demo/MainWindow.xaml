<fg:FrostedWindow x:Class="Frosted.Wpf.Demo.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:fg="urn:frosted-wpf"
                  xmlns:views="clr-namespace:Frosted.Wpf.Demo.Views"
                  x:Name="Window"
                  Title="Frosted Glass — Control library"
                  Width="1500" Height="1000" MinWidth="900" MinHeight="600"
                  WindowStartupLocation="CenterScreen">
    <!-- Slides in from the right (Custom controls page: Open flyout) -->
    <fg:FrostedWindow.Flyouts>
        <Grid>
            <fg:Flyout x:Name="SettingsFlyout" Header="Display settings" Width="360">
                <StackPanel>
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Margin="0,0,0,16"
                               Text="A flyout floats over the page; Escape or the × closes it." />
                    <CheckBox Style="{StaticResource Frosted.Styles.ToggleSwitch}" Content="Show hidden files" IsChecked="True" />
                    <CheckBox Style="{StaticResource Frosted.Styles.ToggleSwitch}" Content="Compact rows" />
                    <Label Margin="0,14,0,0" Content="_Sort by" Target="{Binding ElementName=FlyoutSort}" />
                    <ComboBox x:Name="FlyoutSort" SelectedIndex="0">
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Date modified" />
                        <ComboBoxItem Content="Size" />
                    </ComboBox>
                    <Label Margin="0,14,0,0" Content="_Thumbnail size" Target="{Binding ElementName=FlyoutSize}" />
                    <fg:NumericUpDown x:Name="FlyoutSize" Minimum="16" Maximum="256" Interval="16" Value="96" StringFormat="0 'px'" />
                </StackPanel>
            </fg:Flyout>
        </Grid>
    </fg:FrostedWindow.Flyouts>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation and the glass settings -->
        <DockPanel Margin="16,12,16,20">
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Margin="8,0,8,12" Style="{StaticResource Frosted.Styles.TextBlock.Eyebrow}" Text="GLASS" />
                <TextBlock Margin="8,0,0,6" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Backdrop" />
                <ComboBox x:Name="BackdropBox" Margin="8,0,0,14" SelectedItem="{Binding Backdrop, ElementName=Window}" />
                <DockPanel Margin="8,0,0,0">
                    <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Text="{Binding TintOpacity, ElementName=Window, StringFormat={}{0:P0}}" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Tint" />
                </DockPanel>
                <Slider Margin="8,0,0,14" Minimum="0.2" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding TintOpacity, ElementName=Window}" AutomationProperties.Name="Tint" />
                <TextBlock Margin="8,0,0,8" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Accent" />
                <StackPanel x:Name="AccentPicker" Margin="8,0,0,0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.Green}" Background="#1F9D57"
                                 IsChecked="True" ToolTip="Green" AutomationProperties.Name="Green" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.Orange}" Background="#D9661A"
                                 ToolTip="Orange" AutomationProperties.Name="Orange" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.Blue}" Background="#1F78D1"
                                 ToolTip="Blue" AutomationProperties.Name="Blue" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.Yellow}" Background="#D1A112"
                                 ToolTip="Yellow" AutomationProperties.Name="Yellow" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.Red}" Background="#D13A3A"
                                 ToolTip="Red" AutomationProperties.Name="Red" Checked="OnAccentChecked" />
                    <!-- Filled from code with the colour chosen in Windows -->
                    <RadioButton x:Name="SystemSwatch" Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static fg:FrostedAccent.System}"
                                 ToolTip="Windows accent colour" AutomationProperties.Name="Windows accent colour" Checked="OnAccentChecked" />
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Margin="8,8,8,12" Style="{StaticResource Frosted.Styles.TextBlock.Eyebrow}" Text="LIBRARY" />
            <ListBox x:Name="Navigation" Style="{StaticResource Frosted.Styles.ListBox.Navigation}" SelectedIndex="0"
                     SelectionChanged="OnNavigationChanged" AutomationProperties.Name="Library">
                <ListBoxItem AutomationProperties.Name="Controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Frosted.Styles.IconTile.Small}">
                            <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Grid}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="More controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Frosted.Styles.IconTile.Small}">
                            <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Folder}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="More controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Custom controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Frosted.Styles.IconTile.Small}">
                            <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Components}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Custom controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Layers and colours">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Frosted.Styles.IconTile.Small}">
                            <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Layers}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Layers &amp; colours" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Pages -->
        <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,12,32,32">
                <views:ControlsPage x:Name="ControlsPage" />
                <views:MoreControlsPage x:Name="MoreControlsPage" Visibility="Collapsed" />
                <views:CustomControlsPage x:Name="CustomControlsPage" Visibility="Collapsed" />
                <views:TokensPage x:Name="TokensPage" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</fg:FrostedWindow>
