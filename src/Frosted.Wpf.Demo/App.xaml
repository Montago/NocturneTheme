<Application x:Class="Frosted.Wpf.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Frosted.Wpf;component/Styles/Frosted.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Demo layout -->
            <Style x:Key="Demo.Card" TargetType="HeaderedContentControl" BasedOn="{StaticResource Frosted.Styles.Card}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <!-- A key / value line, as in the tab panels -->
            <Style x:Key="Demo.Key" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Secondary}" />
            </Style>
            <Style x:Key="Demo.Value" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <Style x:Key="Demo.StateLabel" TargetType="TextBlock" BasedOn="{StaticResource Frosted.Styles.TextBlock.Mono}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
