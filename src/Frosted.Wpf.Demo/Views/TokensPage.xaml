<UserControl x:Class="Frosted.Wpf.Demo.Views.TokensPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fg="urn:frosted-wpf">
    <UserControl.Resources>
        <Style x:Key="LayerSample" TargetType="Border">
            <Setter Property="Height" Value="120" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Stroke}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Shape" TargetType="Border">
            <Setter Property="Height" Value="56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SpecRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Title}" Text="Layers, colours and states" />
        <TextBlock Margin="0,6,0,20" FontSize="14" Foreground="{DynamicResource Frosted.Brushes.Text.Secondary}"
                   Text="Every surface is a plain SolidColorBrush with alpha over the backdrop — no blur inside the window. Resource keys are Frosted.Brushes.*." />

        <!-- Layer stack -->
        <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="LAYERS — FROM THE BOTTOM UP">
            <UniformGrid Columns="5">
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource LayerSample}" Background="Transparent" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="1 · Backdrop" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Backdrop = Mica, MicaAlt, Acrylic or None (opaque Window.Fallback)" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource LayerSample}">
                        <Rectangle Fill="{DynamicResource Frosted.Brushes.Window.Tint}" Opacity="{Binding TintOpacity, RelativeSource={RelativeSource AncestorType=fg:FrostedWindow}}" />
                    </Border>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="2 · Tint" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Window.Tint #101E16 × TintOpacity (0.55)" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource LayerSample}">
                        <Grid>
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Window.Tint}" Opacity="0.55" />
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Noise}" Opacity="1" />
                        </Grid>
                    </Border>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="3 · Grain" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Noise 256 × 256, tiled × NoiseOpacity (0.8)" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource LayerSample}">
                        <Grid>
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Window.Tint}" Opacity="0.55" />
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Noise}" Opacity="0.8" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#26FFFFFF" />
                                        <GradientStop Offset="0.6" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="4 · Light" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Window.Light: 8 % white from the top-left corner" />
                </StackPanel>
                <StackPanel>
                    <Border Style="{StaticResource LayerSample}">
                        <Grid>
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Window.Tint}" Opacity="0.55" />
                            <Rectangle Fill="{DynamicResource Frosted.Brushes.Noise}" Opacity="0.8" />
                            <Border Margin="14,22" CornerRadius="10" Background="{DynamicResource Frosted.Brushes.Surface1}"
                                    BorderBrush="{DynamicResource Frosted.Brushes.Surface1.Border}" BorderThickness="1">
                                <Border Margin="10,0" Height="28" CornerRadius="7" Background="{DynamicResource Frosted.Brushes.Surface2}" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="5 · Glass surfaces" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Surface1 (cards) · Surface2 (selected)" />
                </StackPanel>
            </UniformGrid>
        </HeaderedContentControl>

        <!-- Colours -->
        <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="COLOURS — RESOURCE KEY · #AARRGGBB">
            <ItemsControl x:Name="Swatches" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,14,16">
                            <Border Height="56" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Frosted.Brushes.Stroke}" Background="{Binding Brush}" />
                            <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="{Binding Value}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </HeaderedContentControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Typography -->
            <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="TYPOGRAPHY — SEGOE UI">
                <StackPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Title · 30 / 600" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Title}" Text="Page title" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Subtitle · 20 / 600" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Subtitle}" Text="Subtitle" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Eyebrow · 12 / 700" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Eyebrow}" Text="SECTION LABEL" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.ListTitle · 16 / 500" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.ListTitle}" Text="List title" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Body · 14 / 400, buttons 600" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Body}" Text="Body text and controls" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Caption · 13 / 400" /><TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Captions and labels" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="TextBlock.Hint · 12 / 400" /><TextBlock Margin="0" Style="{StaticResource Frosted.Styles.TextBlock.Hint}" Text="Hints and tool tips" /></DockPanel>
                </StackPanel>
            </HeaderedContentControl>

            <!-- Shapes and sizes -->
            <HeaderedContentControl Grid.Column="2" Style="{StaticResource Demo.Card}" Header="SHAPE AND SIZE">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,14,6"><Border Style="{StaticResource Shape}" CornerRadius="8" /><TextBlock FontSize="13" Text="Window · 8" /></StackPanel>
                        <StackPanel Margin="0,0,14,6"><Border Style="{StaticResource Shape}" CornerRadius="14" /><TextBlock FontSize="13" Text="Card · 14" /></StackPanel>
                        <StackPanel Margin="0,0,0,6"><Border Style="{StaticResource Shape}" CornerRadius="12" /><TextBlock FontSize="13" Text="List item · 12" /></StackPanel>
                        <StackPanel Margin="0,0,14,6"><Border Style="{StaticResource Shape}" CornerRadius="10" /><TextBlock FontSize="13" Text="Icon tile, popup · 10" /></StackPanel>
                        <StackPanel Margin="0,0,14,6"><Border Style="{StaticResource Shape}" CornerRadius="8" /><TextBlock FontSize="13" Text="Button, field · 8" /></StackPanel>
                        <StackPanel Margin="0,0,0,6"><Border Style="{StaticResource Shape}" CornerRadius="5" /><TextBlock FontSize="13" Text="CheckBox · 5" /></StackPanel>
                    </UniformGrid>
                    <DockPanel Margin="0,14,0,8"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="36 px (fields, buttons, tabs, menu items)" /><TextBlock FontSize="13" Text="Control height" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="42 × 42 · icon 20 px, stroke 1.6" /><TextBlock FontSize="13" Text="Icon tile" /></DockPanel>
                    <DockPanel Style="{StaticResource SpecRow}"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="4 · 8 · 10 · 14 · 16 · 20 · 32" /><TextBlock FontSize="13" Text="Spacing" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.TextBlock.Mono}" Text="44 px · caption buttons 46 × 32" /><TextBlock FontSize="13" Text="Title bar" /></DockPanel>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>

        <!-- States: real controls -->
        <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="STATES">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Demo.StateLabel}" Text="REST (hover me)" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Demo.StateLabel}" Text="CHECKED / ERROR" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Demo.StateLabel}" Text="DISABLED" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Primary button" />
                    <Button Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource Frosted.Styles.Button.Primary}" Content="Save" />
                    <ToggleButton Grid.Row="1" Grid.Column="3" Margin="0,0,0,12" Content="Save" IsChecked="True" />
                    <Button Grid.Row="1" Grid.Column="5" Margin="0,0,0,12" Style="{StaticResource Frosted.Styles.Button.Primary}" Content="Save" IsEnabled="False" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Secondary button" />
                    <Button Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Content="Cancel" />
                    <ToggleButton Grid.Row="2" Grid.Column="3" Margin="0,0,0,12" Content="Cancel" />
                    <Button Grid.Row="2" Grid.Column="5" Margin="0,0,0,12" Content="Cancel" IsEnabled="False" />

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="TextBox" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Text="Text" />
                    <TextBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,12" Text="Text" fg:ControlHelper.HasError="True" />
                    <TextBox Grid.Row="3" Grid.Column="5" Margin="0,0,0,12" Text="Text" IsEnabled="False" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="List item" />
                    <ListBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Rest">
                        <ListBoxItem Margin="0" Padding="12,8" Content="Item" />
                    </ListBox>
                    <ListBox Grid.Row="4" Grid.Column="3" SelectedIndex="0" AutomationProperties.Name="Selected">
                        <ListBoxItem Margin="0" Padding="12,8" Content="Item (selected)" />
                    </ListBox>
                    <ListBox Grid.Row="4" Grid.Column="5" AutomationProperties.Name="Disabled">
                        <ListBoxItem Margin="0" Padding="12,8" Content="Item" IsEnabled="False" />
                    </ListBox>
                </Grid>
                <TextBlock Margin="0,18,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}"
                           Text="Transitions: 120 ms on backgrounds (buttons, list items, tabs, expander headers), 150 ms on the switch knob and the chevrons. Keyboard focus: a 2px white ring 2px outside the control; fields show a 2px accent line instead." />
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
