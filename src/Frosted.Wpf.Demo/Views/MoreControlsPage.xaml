<UserControl x:Class="Frosted.Wpf.Demo.Views.MoreControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fg="urn:frosted-wpf">
    <UserControl.Resources>
        <!-- A folder or file icon in front of a name -->
        <Style x:Key="ItemIcon" TargetType="fg:StrokeIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Secondary}" />
            <Setter Property="Data" Value="{StaticResource Frosted.Icons.File}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page header -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Title}" Text="More controls" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource Frosted.Brushes.Text.Secondary}"
                       Text="The rest of the standard set: trees, lists with columns, dates, tool bars, splitters, status bars and rich text." />
        </StackPanel>

        <!-- A small file manager: everything an app frame is built from -->
        <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="APP FRAME" Tag="ToolBar · TreeView · GridSplitter · ListView · StatusBar">
            <DockPanel Height="420">
                <ToolBarTray DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ToolBar x:Name="FileToolBar">
                        <Button ToolTip="New folder" AutomationProperties.Name="New folder">
                            <StackPanel Orientation="Horizontal">
                                <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Plus}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="New" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Refresh" AutomationProperties.Name="Refresh">
                            <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Refresh}" />
                        </Button>
                        <Separator />
                        <Button ToolTip="Cut" AutomationProperties.Name="Cut">
                            <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Cut}" />
                        </Button>
                        <Button ToolTip="Copy" AutomationProperties.Name="Copy">
                            <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Copy}" />
                        </Button>
                        <Button ToolTip="Paste" AutomationProperties.Name="Paste">
                            <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Paste}" />
                        </Button>
                        <Button ToolTip="Delete" AutomationProperties.Name="Delete">
                            <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Delete}" />
                        </Button>
                        <Separator />
                        <ToggleButton Content="Details" IsChecked="True" />
                        <ToggleButton Content="Preview" />
                        <CheckBox Content="Hidden files" />
                        <Separator />
                        <ComboBox Width="150" SelectedIndex="0" AutomationProperties.Name="Sort by">
                            <ComboBoxItem Content="Name" />
                            <ComboBoxItem Content="Date modified" />
                            <ComboBoxItem Content="Size" />
                        </ComboBox>
                        <TextBox Width="180" fg:ControlHelper.Placeholder="Filter" AutomationProperties.Name="Filter" />
                    </ToolBar>
                </ToolBarTray>

                <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StatusBarItem Content="7 items" />
                    <Separator />
                    <StatusBarItem Content="1 selected · 388 KB" />
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource Frosted.Brushes.Success}" />
                            <TextBlock Text="Synchronised today 07:12" />
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="160" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" AutomationProperties.Name="Folders">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneTime}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <fg:StrokeIcon Style="{StaticResource ItemIcon}" Data="{StaticResource Frosted.Icons.Folder}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Resize the folder pane" />

                    <ListView x:Name="FileList" Grid.Column="2" ItemsSource="{Binding Files}" SelectedIndex="1" AutomationProperties.Name="Files">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="NAME" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <fg:StrokeIcon x:Name="Icon" Style="{StaticResource ItemIcon}" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource Frosted.Icons.Folder}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MODIFIED" Width="150" DisplayMemberBinding="{Binding Modified}" />
                                <GridViewColumn Header="KIND" Width="140" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="SIZE" Width="90" DisplayMemberBinding="{Binding Size}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </DockPanel>
        </HeaderedContentControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="CALENDAR" Tag="Calendar">
                <Calendar x:Name="MeetingCalendar" SelectedDate="{Binding Meeting}" AutomationProperties.Name="Meeting date" />
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Column="2" Style="{StaticResource Demo.Card}" Header="DATEPICKER" Tag="DatePicker">
                <StackPanel>
                    <Label Content="_Meeting" Target="{Binding ElementName=MeetingPicker}" />
                    <DatePicker x:Name="MeetingPicker" SelectedDate="{Binding Meeting}" />

                    <Label Margin="0,14,0,0" Content="_Due date (nothing chosen yet)" Target="{Binding ElementName=DuePicker}" />
                    <DatePicker x:Name="DuePicker" />

                    <Label Margin="0,14,0,0" Content="_End date" Target="{Binding ElementName=EndPicker}" />
                    <DatePicker x:Name="EndPicker" SelectedDate="2026-11-02" fg:ControlHelper.HasError="True" />
                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Error}" Text="Must be after the start date." />

                    <Label Margin="0,14,0,0" Content="Created (disabled)" />
                    <DatePicker SelectedDate="2026-10-01" IsEnabled="False" />
                </StackPanel>
            </HeaderedContentControl>

            <StackPanel Grid.Column="4">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="RICHTEXTBOX" Tag="RichTextBox">
                    <RichTextBox Height="150" AutomationProperties.Name="Release notes">
                        <FlowDocument>
                            <Paragraph>
                                <Bold>This release</Bold> adds the rest of the standard controls.
                            </Paragraph>
                            <Paragraph>
                                Trees, lists with columns, calendars, tool bars and status bars now take the
                                <Italic>frosted</Italic> look, and a GridSplitter divides the panes.
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="DATAGRID · ROW HEADERS" Tag="DataGridRowHeader">
                    <DataGrid x:Name="RowHeaderGrid" Height="196" ItemsSource="{Binding People}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="All" SelectedIndex="1" AutomationProperties.Name="People with row headers">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="ROLE" Width="*" Binding="{Binding Role}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
