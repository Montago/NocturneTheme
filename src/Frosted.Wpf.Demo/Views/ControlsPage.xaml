<UserControl x:Class="Frosted.Wpf.Demo.Views.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fg="urn:frosted-wpf"
             xmlns:demo="clr-namespace:Frosted.Wpf.Demo">
    <UserControl.Resources>
        <demo:OnOffConverter x:Key="OnOff" />

        <!-- A switch with a label and its state underneath -->
        <DataTemplate x:Key="SwitchContent">
            <StackPanel>
                <TextBlock Text="{Binding}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource Frosted.Brushes.Text.Hint}"
                           Text="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}, Converter={StaticResource OnOff}}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StatusPill" TargetType="ContentControl" BasedOn="{StaticResource Frosted.Styles.Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Invited">
                    <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Warning}" />
                    <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Warning.Background}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                    <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Error.Text}" />
                    <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Error.Background}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page header -->
        <DockPanel Margin="0,0,0,20">
            <TextBox DockPanel.Dock="Right" Width="280" VerticalAlignment="Bottom" Style="{StaticResource Frosted.Styles.TextBox.Search}"
                     fg:ControlHelper.Placeholder="Search controls…" AutomationProperties.Name="Search controls" />
            <StackPanel>
                <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Title}" Text="Controls" />
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource Frosted.Brushes.Text.Secondary}"
                           Text="Frosted glass over Mica — the most used WPF controls at rest, on hover, in focus and with an error." />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1 -->
            <StackPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="BUTTON" Tag="Button · RepeatButton">
                    <StackPanel>
                        <WrapPanel>
                            <Button Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.Button.Primary}" Content="Save changes" IsDefault="True" />
                            <Button Margin="0,0,10,10" Content="Cancel" />
                            <Button Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.Button.Subtle}" Content="More" />
                            <Button Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.Button.Icon}" ToolTip="Refresh" AutomationProperties.Name="Refresh">
                                <fg:StrokeIcon Width="18" Height="18" StrokeThickness="1.7" Data="{StaticResource Frosted.Icons.Refresh}" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Margin="0,8,0,6" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Toggle, repeat and disabled" />
                        <UniformGrid Columns="4">
                            <ToggleButton Margin="0,0,8,0" Padding="0" Content="Off" />
                            <ToggleButton Margin="0,0,8,0" Padding="0" Content="On" IsChecked="True" />
                            <RepeatButton Margin="0,0,8,0" Padding="0" Content="Repeat" />
                            <Button Padding="0" Style="{StaticResource Frosted.Styles.Button.Primary}" Content="Disabled" IsEnabled="False" />
                        </UniformGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="TEXTBOX · PASSWORDBOX" Tag="TextBox · PasswordBox">
                    <StackPanel>
                        <Label Content="_Server name" Target="{Binding ElementName=ServerBox}" />
                        <TextBox x:Name="ServerBox" Text="{Binding ServerName}" />

                        <Label Margin="0,14,0,0" Content="_User name" Target="{Binding ElementName=UserBox}" />
                        <TextBox x:Name="UserBox" fg:ControlHelper.Placeholder="e.g. anna.holm" />

                        <Label Margin="0,14,0,0" Content="_Password" Target="{Binding ElementName=PasswordBox}" />
                        <PasswordBox x:Name="PasswordBox" fg:PasswordBoxHelper.CanReveal="True" fg:ControlHelper.Placeholder="Password" />

                        <Label Margin="0,14,0,0" Content="P_ort" Target="{Binding ElementName=PortBox}" />
                        <TextBox x:Name="PortBox">
                            <TextBox.Text>
                                <Binding Path="Port" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <demo:PortRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PortBox}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Frosted.Styles.TextBlock.Error}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (Validation.HasError), ElementName=PortBox}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="COMBOBOX" Tag="ComboBox">
                    <StackPanel>
                        <Label Content="_Language" Target="{Binding ElementName=LanguageBox}" />
                        <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                        <Label Margin="0,14,0,0" Content="_Editable" Target="{Binding ElementName=EditableBox}" />
                        <ComboBox x:Name="EditableBox" IsEditable="True" ItemsSource="{Binding Languages}" Text="Norsk" />
                        <Label Margin="0,14,0,0" Content="_Nothing chosen yet" Target="{Binding ElementName=EmptyBox}" />
                        <ComboBox x:Name="EmptyBox" ItemsSource="{Binding Languages}" fg:ControlHelper.Placeholder="Choose a language" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <!-- Column 2 -->
            <StackPanel Grid.Column="2">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="CHECKBOX" Tag="CheckBox · IsThreeState">
                    <StackPanel>
                        <CheckBox Margin="0,0,0,4" Content="Start automatically with Windows" IsChecked="True" />
                        <CheckBox Margin="0,0,0,4" Content="Send anonymous usage statistics" />
                        <CheckBox Margin="0,0,0,4" Content="Select all folders (partly selected)" IsThreeState="True" IsChecked="{x:Null}" />
                        <CheckBox Content="Require administrator (disabled)" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="RADIOBUTTON" Tag="RadioButton · GroupName">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Updates" />
                        <RadioButton Margin="0,0,0,4" GroupName="Updates" Content="Automatic (recommended)" IsChecked="True" />
                        <RadioButton Margin="0,0,0,4" GroupName="Updates" Content="Notify before installing" />
                        <RadioButton GroupName="Updates" Content="Never" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="GROUPBOX · TOGGLESWITCH" Tag="GroupBox · ToggleButton">
                    <GroupBox Header="Synchronisation">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Frosted.Styles.ToggleSwitch}" ContentTemplate="{StaticResource SwitchContent}"
                                      Content="Synchronise in the background" IsChecked="True" />
                            <CheckBox Style="{StaticResource Frosted.Styles.ToggleSwitch}" ContentTemplate="{StaticResource SwitchContent}"
                                      Content="Only on unmetered networks" />
                            <CheckBox Style="{StaticResource Frosted.Styles.ToggleSwitch}" ContentTemplate="{StaticResource SwitchContent}"
                                      Content="Keep deleted files for 30 days" IsChecked="True" />
                        </StackPanel>
                    </GroupBox>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="SLIDER · PROGRESSBAR" Tag="Slider · ProgressBar">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Text="{Binding Bandwidth, StringFormat={}{0:0} Mbit/s}" />
                            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Bandwidth limit" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Bandwidth}" SmallChange="1" LargeChange="10" AutomationProperties.Name="Bandwidth limit" />

                        <DockPanel Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Text="64 %" />
                            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Uploading 128 of 200 files" />
                        </DockPanel>
                        <ProgressBar Value="64" AutomationProperties.Name="Upload" />

                        <TextBlock Margin="0,16,0,6" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Connecting… (IsIndeterminate)" />
                        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Connecting" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <!-- Column 3 -->
            <StackPanel Grid.Column="4">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="TABCONTROL · SEGMENTS" Tag="TabControl · TabItem">
                    <TabControl>
                        <TabItem Header="General">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Dark, frosted glass" /><TextBlock Style="{StaticResource Demo.Key}" Text="Theme" /></DockPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Mica" /><TextBlock Style="{StaticResource Demo.Key}" Text="Backdrop" /></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Meadow green" /><TextBlock Style="{StaticResource Demo.Key}" Text="Accent colour" /></DockPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Network">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Automatic" /><TextBlock Style="{StaticResource Demo.Key}" Text="Proxy" /></DockPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="30 s" /><TextBlock Style="{StaticResource Demo.Key}" Text="Timeout" /></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Enabled" /><TextBlock Style="{StaticResource Demo.Key}" Text="IPv6" /></DockPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Advanced">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Information" /><TextBlock Style="{StaticResource Demo.Key}" Text="Log level" /></DockPanel>
                                <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="On" /><TextBlock Style="{StaticResource Demo.Key}" Text="Hardware acceleration" /></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Off" /><TextBlock Style="{StaticResource Demo.Key}" Text="Diagnostics" /></DockPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </HeaderedContentControl>

                <!-- Document tabs sit straight on the window, without a card -->
                <DockPanel Margin="2,4,2,12">
                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.Tag}" Content="TabControl · TabItem" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Frosted.Styles.TextBlock.Eyebrow}" Text="TABCONTROL · DOCUMENTS" />
                </DockPanel>
                <TabControl x:Name="DocumentTabs" Margin="0,0,0,20" Style="{StaticResource Frosted.Styles.TabControl.Document}"
                            fg:TabHelper.ShowCloseButton="True" fg:TabHelper.ShowAddButton="True">
                    <TabControl.CommandBindings>
                        <CommandBinding Command="{x:Static fg:TabHelper.AddTabCommand}" Executed="OnAddTab" />
                    </TabControl.CommandBindings>
                    <TabItem Header="Overview">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="1,284" /><TextBlock Style="{StaticResource Demo.Key}" Text="Files" /></DockPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="18.6 GB" /><TextBlock Style="{StaticResource Demo.Key}" Text="Total size" /></DockPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Today 07:12" /><TextBlock Style="{StaticResource Demo.Key}" Text="Last synchronised" /></DockPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Logs">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Synchronisation complete" /><TextBlock Style="{StaticResource Demo.Key}" Text="07:12:04" /></DockPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="128 files uploaded" /><TextBlock Style="{StaticResource Demo.Key}" Text="07:11:58" /></DockPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Connected to server" /><TextBlock Style="{StaticResource Demo.Key}" Text="07:10:02" /></DockPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Conflicts" fg:TabHelper.Badge="2">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Changed in both places" /><TextBlock Style="{StaticResource Demo.Key}" Text="Budget 2027.xlsx" /></DockPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Demo.Value}" Text="Deleted locally" /><TextBlock Style="{StaticResource Demo.Key}" Text="Notes.md" /></DockPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="LISTBOX" Tag="ListBox · ListBoxItem">
                    <ListBox SelectedIndex="0" AutomationProperties.Name="Settings">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Frosted.Styles.IconTile}"><fg:StrokeIcon Data="{StaticResource Frosted.Icons.Sync}" /></ContentControl>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.ListTitle}" Text="Synchronisation" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Keep files up to date across devices" />
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Frosted.Styles.IconTile}"><fg:StrokeIcon Data="{StaticResource Frosted.Icons.Shield}" /></ContentControl>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.ListTitle}" Text="Security" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Passwords, 2FA and certificates" />
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Frosted.Styles.IconTile}"><fg:StrokeIcon Data="{StaticResource Frosted.Icons.Globe}" /></ContentControl>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.ListTitle}" Text="Network" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Proxy, DNS and connections" />
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Frosted.Styles.IconTile}"><fg:StrokeIcon Data="{StaticResource Frosted.Icons.Database}" /></ContentControl>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.ListTitle}" Text="Storage" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Disk usage and clean-up" />
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="EXPANDER" Tag="Expander">
                    <Expander Header="Advanced settings" IsExpanded="True">
                        <TextBlock LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource Frosted.Brushes.Text.Label}">
                            The content folds out under the header and shares the card's glass. IsExpanded turns the chevron with a 150 ms animation.
                        </TextBlock>
                    </Expander>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>

        <!-- Bottom row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="DATAGRID · SCROLLBAR" Tag="DataGrid · ScrollViewer">
                <DataGrid x:Name="PeopleGrid" Height="262" ItemsSource="{Binding People}" AutoGenerateColumns="False" IsReadOnly="True" SelectedIndex="0"
                          AutomationProperties.Name="People">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Selected"
                                              IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NAME" Width="1.3*" SortMemberPath="Name" SortDirection="Ascending">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ROLE" Width="*" Binding="{Binding Role}" />
                        <DataGridTemplateColumn Header="STATUS" Width="*" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource StatusPill}" Content="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="LAST ACTIVE" Width="*" Binding="{Binding LastActive}" />
                    </DataGrid.Columns>
                </DataGrid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Column="2" Style="{StaticResource Demo.Card}" Header="TOOLTIP · CONTEXTMENU" Tag="ToolTip · ContextMenu">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CopyButton" Style="{StaticResource Frosted.Styles.Button.Icon}" AutomationProperties.Name="Copy">
                            <Button.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Copy to clipboard" />
                                    <TextBlock Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource Frosted.Brushes.Shortcut}" Text="Ctrl+C" />
                                </StackPanel>
                            </Button.ToolTip>
                            <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Copy}" />
                        </Button>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Hover for the tool tip" />
                    </StackPanel>

                    <Border x:Name="MenuTarget" Margin="0,14,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource Frosted.Brushes.Surface.Sunken}"
                            BorderBrush="{DynamicResource Frosted.Brushes.Stroke}" BorderThickness="1">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" InputGestureText="Ctrl+X" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Cut}" />
                                <MenuItem Header="Copy" InputGestureText="Ctrl+C" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Copy}" />
                                <MenuItem Header="Paste" InputGestureText="Ctrl+V" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Paste}" />
                                <Separator />
                                <MenuItem Header="Show hidden files" IsCheckable="True" IsChecked="True" />
                                <MenuItem Header="Sort by">
                                    <MenuItem Header="Name" IsCheckable="True" IsChecked="True" />
                                    <MenuItem Header="Date modified" IsCheckable="True" />
                                    <MenuItem Header="Size" IsCheckable="True" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Rename" InputGestureText="F2" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Edit}" />
                                <MenuItem Header="Delete" InputGestureText="Del" Foreground="{DynamicResource Frosted.Brushes.Error.Text}"
                                          fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Delete}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Caption}" Text="Right-click here for the context menu." />
                    </Border>

                    <TextBlock Margin="0,16,0,6" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Menu bar" />
                    <Menu>
                        <MenuItem Header="_File">
                            <MenuItem Header="_New" InputGestureText="Ctrl+N" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Plus}" />
                            <MenuItem Header="_Open…" InputGestureText="Ctrl+O" />
                            <Separator />
                            <MenuItem Header="E_xit" />
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Cut}" />
                            <MenuItem Header="_Copy" InputGestureText="Ctrl+C" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Copy}" />
                            <MenuItem Header="_Paste" InputGestureText="Ctrl+V" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Paste}" />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="_Status bar" IsCheckable="True" IsChecked="True" />
                            <MenuItem Header="_Zoom">
                                <MenuItem Header="Zoom _in" InputGestureText="Ctrl++" />
                                <MenuItem Header="Zoom _out" InputGestureText="Ctrl+-" />
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </StackPanel>
</UserControl>
