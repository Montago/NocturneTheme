<UserControl x:Class="Frosted.Wpf.Demo.Views.CustomControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fg="urn:frosted-wpf">
    <StackPanel>
        <!-- Page header -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Title}" Text="Custom controls" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource Frosted.Brushes.Text.Secondary}"
                       Text="Controls WPF does not have, in frosted glass: menu buttons, number and time fields, pickers, message bars, dialogs, flyouts and navigation." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1 -->
            <StackPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="MENU BUTTONS" Tag="fg:DropDownButton · fg:SplitButton">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Drop-down: the whole button opens the menu" />
                        <WrapPanel>
                            <fg:DropDownButton x:Name="ExportButton" Margin="0,0,10,10" Content="Export">
                                <fg:DropDownButton.Menu>
                                    <ContextMenu>
                                        <MenuItem Header="PDF document" />
                                        <MenuItem Header="CSV for Excel" />
                                        <MenuItem Header="PNG image" />
                                    </ContextMenu>
                                </fg:DropDownButton.Menu>
                            </fg:DropDownButton>
                            <fg:DropDownButton Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.DropDownButton.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <fg:StrokeIcon Width="16" Height="16" Data="{StaticResource Frosted.Icons.Plus}" />
                                    <TextBlock Margin="6,0,0,0" Text="New" />
                                </StackPanel>
                                <fg:DropDownButton.Menu>
                                    <ContextMenu>
                                        <MenuItem Header="Folder" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Folder}" />
                                        <MenuItem Header="Document" fg:ControlHelper.Icon="{StaticResource Frosted.Icons.File}" />
                                    </ContextMenu>
                                </fg:DropDownButton.Menu>
                            </fg:DropDownButton>
                        </WrapPanel>

                        <TextBlock Margin="0,6,0,6" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Split: the chevron opens the other choices" />
                        <WrapPanel>
                            <fg:SplitButton Margin="0,0,10,10" Content="Save">
                                <fg:SplitButton.Menu>
                                    <ContextMenu>
                                        <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" />
                                        <MenuItem Header="Save all" />
                                    </ContextMenu>
                                </fg:SplitButton.Menu>
                            </fg:SplitButton>
                            <fg:SplitButton Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.SplitButton.Primary}" Content="Synchronise">
                                <fg:SplitButton.Menu>
                                    <ContextMenu>
                                        <MenuItem Header="Synchronise this folder" />
                                        <MenuItem Header="Pause for an hour" />
                                    </ContextMenu>
                                </fg:SplitButton.Menu>
                            </fg:SplitButton>
                            <fg:DropDownButton Margin="0,0,10,10" Content="Disabled" IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="NUMERICUPDOWN" Tag="fg:NumericUpDown">
                    <StackPanel>
                        <Label Content="_Port" Target="{Binding ElementName=PortNumber}" />
                        <fg:NumericUpDown x:Name="PortNumber" Minimum="1" Maximum="65535" Value="8080" AutomationProperties.Name="Port" />

                        <Label Margin="0,14,0,0" Content="_Timeout (steps of 5, StringFormat)" Target="{Binding ElementName=TimeoutNumber}" />
                        <fg:NumericUpDown x:Name="TimeoutNumber" Minimum="0" Maximum="300" Interval="5" Value="30" StringFormat="0 's'" AutomationProperties.Name="Timeout" />

                        <Label Margin="0,14,0,0" Content="_Retries (out of range)" Target="{Binding ElementName=RetriesNumber}" />
                        <fg:NumericUpDown x:Name="RetriesNumber" Value="12" fg:ControlHelper.HasError="True" AutomationProperties.Name="Retries" />
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Error}" Text="At most 10 retries." />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <!-- Column 2 -->
            <StackPanel Grid.Column="2">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="TEXTBOX · CLEAR BUTTON" Tag="ControlHelper.ClearButton">
                    <StackPanel>
                        <Label Content="_Server name" Target="{Binding ElementName=ClearServer}" />
                        <TextBox x:Name="ClearServer" Text="intranet.local" fg:ControlHelper.ClearButton="True" />
                        <Label Margin="0,14,0,0" Content="S_earch" Target="{Binding ElementName=ClearSearch}" />
                        <TextBox x:Name="ClearSearch" Style="{StaticResource Frosted.Styles.TextBox.Search}" Text="frosted"
                                 fg:ControlHelper.ClearButton="True" fg:ControlHelper.Placeholder="Search files" />
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Hint}" Text="The × shows while there is text and empties the box." />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="PROGRESSRING" Tag="fg:ProgressRing">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <fg:ProgressRing Width="20" Height="20" Margin="0,0,20,0" />
                            <fg:ProgressRing Margin="0,0,20,0" />
                            <fg:ProgressRing Width="48" Height="48" />
                        </StackPanel>
                        <TextBlock Margin="0,16,0,8" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Inside a button" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource Frosted.Styles.Button.Primary}" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <fg:ProgressRing Width="16" Height="16" Margin="0,0,10,0" Foreground="{DynamicResource Frosted.Brushes.Text.OnAccent}" Background="#33FFFFFF" />
                                <TextBlock Text="Saving…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <!-- Column 3 -->
            <StackPanel Grid.Column="4">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="DIALOG · FLYOUT" Tag="fg:FrostedDialog · fg:Flyout">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Body}" Foreground="{DynamicResource Frosted.Brushes.Text.Label}" LineHeight="21"
                                   Text="A dialog dims the page and waits for an answer (await ShowMessageAsync). A flyout slides in from the edge of the window." />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Margin="0,0,10,10" Style="{StaticResource Frosted.Styles.Button.Primary}" Content="Show dialog" Click="OnShowDialog" />
                            <Button Margin="0,0,10,10" Content="Open flyout" Click="OnOpenFlyout" />
                        </WrapPanel>
                        <TextBlock x:Name="DialogResultText" Style="{StaticResource Frosted.Styles.TextBlock.Hint}" Text="No answer yet." />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>

        <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="INFOBAR" Tag="fg:InfoBar · Severity">
            <StackPanel>
                <fg:InfoBar Margin="0,0,0,10" Title="Update available." Message="Frosted Glass can be updated when you restart the app." IsClosable="False">
                    <Button Content="Restart" />
                </fg:InfoBar>
                <fg:InfoBar Margin="0,0,0,10" Severity="Success" Title="Synchronised." Message="128 files were uploaded at 07:12." />
                <fg:InfoBar Margin="0,0,0,10" Severity="Warning" Title="Almost full." Message="The shared drive has 2.1 GB free." />
                <fg:InfoBar Severity="Error" Title="Could not connect." Message="intranet.local did not answer within 30 s.">
                    <Button Content="Try again" />
                </fg:InfoBar>
            </StackPanel>
        </HeaderedContentControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="PICKERS" Tag="fg:TimePicker · ColorPicker · …">
                <StackPanel>
                    <Label Content="_Meeting time" Target="{Binding ElementName=MeetingTime}" />
                    <fg:TimePicker x:Name="MeetingTime" SelectedTime="09:30:00" MinuteStep="30" AutomationProperties.Name="Meeting time" />

                    <Label Margin="0,14,0,0" Content="_Label colour" Target="{Binding ElementName=LabelColour}" />
                    <fg:ColorPicker x:Name="LabelColour" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="Label colour" />

                    <Label Margin="0,14,0,0" Content="_City (AutoSuggestBox)" Target="{Binding ElementName=CityBox}" />
                    <fg:AutoSuggestBox x:Name="CityBox" ItemsSource="{Binding Cities}" fg:ControlHelper.Placeholder="Start typing a city"
                                       fg:ControlHelper.Icon="{StaticResource Frosted.Icons.Search}" AutomationProperties.Name="City" />

                    <Label Margin="0,14,0,0" Content="_Owner (SearchComboBox)" Target="{Binding ElementName=OwnerBox}" />
                    <fg:SearchComboBox x:Name="OwnerBox" ItemsSource="{Binding People}" DisplayMemberPath="Name" SelectedItem="{Binding People[2], Mode=OneTime}"
                                       fg:ControlHelper.Placeholder="Choose or type a name" AutomationProperties.Name="Owner" />
                </StackPanel>
            </HeaderedContentControl>

            <StackPanel Grid.Column="2">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="RANGESLIDER · RATING" Tag="fg:RangeSlider · fg:Rating">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:0} – {1:0} km">
                                        <Binding Path="LowerValue" ElementName="DistanceRange" />
                                        <Binding Path="UpperValue" ElementName="DistanceRange" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Distance" />
                        </DockPanel>
                        <fg:RangeSlider x:Name="DistanceRange" Minimum="0" Maximum="100" LowerValue="20" UpperValue="65" SmallChange="5" />

                        <TextBlock Margin="0,18,0,8" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Your rating" />
                        <fg:Rating Value="4" AutomationProperties.Name="Rating" />
                        <TextBlock Margin="0,14,0,8" Style="{StaticResource Frosted.Styles.TextBlock.Label}" Text="Average (read-only)" />
                        <fg:Rating Value="3" IsReadOnly="True" Focusable="False" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="BADGED" Tag="fg:Badged">
                    <StackPanel Orientation="Horizontal">
                        <fg:Badged Margin="0,0,24,0" Badge="3">
                            <Button Style="{StaticResource Frosted.Styles.Button.Icon}" ToolTip="Messages" AutomationProperties.Name="Messages">
                                <fg:StrokeIcon Width="18" Height="18" Data="{StaticResource Frosted.Icons.Sync}" />
                            </Button>
                        </fg:Badged>
                        <fg:Badged Margin="0,0,24,0" Badge="12" BadgeBackground="{DynamicResource Frosted.Brushes.Error}" BadgeForeground="#FF2A0E0B">
                            <Button Content="Conflicts" />
                        </fg:Badged>
                        <fg:Badged Badge="New" BadgeBackground="{DynamicResource Frosted.Brushes.Warning}" BadgeForeground="#FF2A2108">
                            <Button Content="Reports" />
                        </fg:Badged>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="TILE" Tag="fg:Tile">
                    <WrapPanel>
                        <fg:Tile Margin="0,0,12,12" Width="150" Title="Files" Count="1,284">
                            <fg:StrokeIcon Width="24" Height="24" Data="{StaticResource Frosted.Icons.Folder}" />
                        </fg:Tile>
                        <fg:Tile Margin="0,0,12,12" Width="150" Style="{StaticResource Frosted.Styles.Tile.Accent}" Title="Synchronise" Count="3">
                            <fg:StrokeIcon Width="24" Height="24" Data="{StaticResource Frosted.Icons.Sync}" />
                        </fg:Tile>
                    </WrapPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Card}" Header="BUSYINDICATOR" Tag="fg:BusyIndicator">
                    <StackPanel>
                        <CheckBox x:Name="BusySwitch" Style="{StaticResource Frosted.Styles.ToggleSwitch}" Content="IsBusy" IsChecked="True" />
                        <fg:BusyIndicator Margin="0,10,0,0" IsBusy="{Binding IsChecked, ElementName=BusySwitch}" BusyContent="Uploading 128 files…">
                            <StackPanel>
                                <Label Content="Folder" />
                                <TextBox Text="Projects\Frosted Glass" />
                                <Label Margin="0,12,0,0" Content="Destination" />
                                <TextBox Text="intranet.local/shared" />
                            </StackPanel>
                        </fg:BusyIndicator>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <HeaderedContentControl Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Demo.Card}" Header="HAMBURGERMENU" Tag="fg:HamburgerMenu · fg:HamburgerMenuItem">
                <Border CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource Frosted.Brushes.Stroke.Subtle}">
                    <fg:HamburgerMenu x:Name="DemoMenu" Height="330" SelectedIndex="0" Content="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="Sections">
                        <fg:HamburgerMenu.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Margin="28,22">
                                    <TextBlock Style="{StaticResource Frosted.Styles.TextBlock.Subtitle}" Text="{Binding}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Frosted.Styles.TextBlock.Caption}"
                                               Text="The page of the selected item goes here. The ☰ button folds the pane to its icons." />
                                </StackPanel>
                            </DataTemplate>
                        </fg:HamburgerMenu.ContentTemplate>
                        <fg:HamburgerMenuItem Content="Dashboard">
                            <fg:HamburgerMenuItem.Icon>
                                <fg:StrokeIcon Data="{StaticResource Frosted.Icons.Grid}" />
                            </fg:HamburgerMenuItem.Icon>
                        </fg:HamburgerMenuItem>
                        <fg:HamburgerMenuItem Content="Files" IsExpanded="True">
                            <fg:HamburgerMenuItem.Icon>
                                <fg:StrokeIcon Data="{StaticResource Frosted.Icons.Folder}" />
                            </fg:HamburgerMenuItem.Icon>
                            <fg:HamburgerMenuItem.Items>
                                <fg:HamburgerMenuItem Content="Recent" />
                                <fg:HamburgerMenuItem Content="Shared with me" />
                            </fg:HamburgerMenuItem.Items>
                        </fg:HamburgerMenuItem>
                        <fg:HamburgerMenuItem Content="Security">
                            <fg:HamburgerMenuItem.Icon>
                                <fg:StrokeIcon Data="{StaticResource Frosted.Icons.Shield}" />
                            </fg:HamburgerMenuItem.Icon>
                        </fg:HamburgerMenuItem>
                        <fg:HamburgerMenuItem Content="Network">
                            <fg:HamburgerMenuItem.Icon>
                                <fg:StrokeIcon Data="{StaticResource Frosted.Icons.Globe}" />
                            </fg:HamburgerMenuItem.Icon>
                        </fg:HamburgerMenuItem>
                    </fg:HamburgerMenu>
                </Border>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Grid.Column="4" Style="{StaticResource Demo.Card}" Header="ACCORDION" Tag="fg:Accordion">
                <fg:Accordion Height="330">
                    <Expander Header="Account" IsExpanded="True">
                        <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Frosted.Brushes.Text.Label}"
                                   Text="Opening one section closes the others; the open one takes the height that is left." />
                    </Expander>
                    <Expander Header="Notifications">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Frosted.Brushes.Text.Label}" Text="E-mail, sounds and badges." />
                    </Expander>
                    <Expander Header="Privacy">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Frosted.Brushes.Text.Label}" Text="Who can see your files." />
                    </Expander>
                </fg:Accordion>
            </HeaderedContentControl>
        </Grid>
    </StackPanel>
</UserControl>
