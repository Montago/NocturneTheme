<nc:NocturneWindow x:Class="Nocturne.Wpf.Demo.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:nc="urn:nocturne-wpf"
                  xmlns:views="clr-namespace:Nocturne.Wpf.Demo.Views"
                  x:Name="Window"
                  Title="Nocturne — Control library"
                  Width="1500" Height="1000" MinWidth="900" MinHeight="600"
                  WindowStartupLocation="CenterScreen">
    <!-- Before the title: back to the previous page, and fold the navigation in or out -->
    <nc:NocturneWindow.LeftWindowCommands>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Style="{StaticResource Nocturne.Styles.Button.Icon.Subtle}" IsEnabled="False" Click="OnBackClick"
                    ToolTip="Back" AutomationProperties.Name="Back">
                <nc:StrokeIcon Width="16" Height="16" Data="{StaticResource Nocturne.Icons.ChevronLeft}" />
            </Button>
            <Button Style="{StaticResource Nocturne.Styles.Button.Icon.Subtle}" Margin="4,0,0,0" Click="OnNavigationToggleClick"
                    ToolTip="Show or hide the navigation" AutomationProperties.Name="Show or hide the navigation">
                <nc:StrokeIcon Width="16" Height="16" Data="{StaticResource Nocturne.Icons.Menu}" />
            </Button>
        </StackPanel>
    </nc:NocturneWindow.LeftWindowCommands>

    <!-- Slides in from the right (Custom controls page: Open flyout) -->
    <nc:NocturneWindow.Flyouts>
        <Grid>
            <nc:Flyout x:Name="SettingsFlyout" Header="Display settings" Width="360">
                <StackPanel>
                    <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Caption}" Margin="0,0,0,16"
                               Text="A flyout floats over the page; Escape or the × closes it." />
                    <CheckBox Style="{StaticResource Nocturne.Styles.ToggleSwitch}" Content="Show hidden files" IsChecked="True" />
                    <CheckBox Style="{StaticResource Nocturne.Styles.ToggleSwitch}" Content="Compact rows" />
                    <Label Margin="0,14,0,0" Content="_Sort by" Target="{Binding ElementName=FlyoutSort}" />
                    <ComboBox x:Name="FlyoutSort" SelectedIndex="0">
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Date modified" />
                        <ComboBoxItem Content="Size" />
                    </ComboBox>
                    <Label Margin="0,14,0,0" Content="_Thumbnail size" Target="{Binding ElementName=FlyoutSize}" />
                    <nc:NumericUpDown x:Name="FlyoutSize" Minimum="16" Maximum="256" Interval="16" Value="96" StringFormat="0 'px'" />
                </StackPanel>
            </nc:Flyout>
        </Grid>
    </nc:NocturneWindow.Flyouts>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation and the window settings -->
        <DockPanel x:Name="NavigationPane" Margin="16,12,16,20">
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Margin="8,0,8,12" Style="{StaticResource Nocturne.Styles.TextBlock.Eyebrow}" Text="WINDOW" />
                <TextBlock Margin="8,0,0,6" Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Backdrop" />
                <ComboBox x:Name="BackdropBox" Margin="8,0,0,8" SelectedItem="{Binding Backdrop, ElementName=Window}" AutomationProperties.Name="Backdrop" />
                <CheckBox Margin="8,0,0,14" Content="Also over Remote Desktop" IsChecked="{Binding UseBackdropInRemoteSession, ElementName=Window}"
                          ToolTip="Off by default: over Remote Desktop the window paints its opaque ground, which draws faster" />
                <Grid Margin="8,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Title bar" />
                    <ComboBox x:Name="TitleBarBox" Grid.Column="1" SelectedItem="{Binding TitleBarStyle, ElementName=Window}" AutomationProperties.Name="Title bar" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Corners" />
                    <ComboBox x:Name="CornerBox" Grid.Row="2" Grid.Column="1" SelectedItem="{Binding CornerStyle, ElementName=Window}" AutomationProperties.Name="Corners" />
                </Grid>
                <DockPanel Margin="8,0,0,0">
                    <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Text="{Binding TintOpacity, ElementName=Window, StringFormat={}{0:P0}}" />
                    <TextBlock Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Tint" />
                </DockPanel>
                <Slider Margin="8,0,0,14" Minimum="0.2" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding TintOpacity, ElementName=Window}" AutomationProperties.Name="Tint" />
                <TextBlock Margin="8,0,0,8" Style="{StaticResource Nocturne.Styles.TextBlock.Label}" Text="Accent" />
                <StackPanel x:Name="AccentPicker" Margin="8,0,0,0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.Green}" Background="#1F9D57"
                                 ToolTip="Green" AutomationProperties.Name="Green" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.Orange}" Background="#D9661A"
                                 ToolTip="Orange" AutomationProperties.Name="Orange" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.Blue}" Background="#1F78D1"
                                 IsChecked="True" ToolTip="Blue" AutomationProperties.Name="Blue" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.Yellow}" Background="#D1A112"
                                 ToolTip="Yellow" AutomationProperties.Name="Yellow" Checked="OnAccentChecked" />
                    <RadioButton Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.Red}" Background="#D13A3A"
                                 ToolTip="Red" AutomationProperties.Name="Red" Checked="OnAccentChecked" />
                    <!-- Filled from code with the colour chosen in Windows -->
                    <RadioButton x:Name="SystemSwatch" Style="{StaticResource Demo.AccentSwatch}" GroupName="Accent" Tag="{x:Static nc:NocturneAccent.System}"
                                 ToolTip="Windows accent colour" AutomationProperties.Name="Windows accent colour" Checked="OnAccentChecked" />
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Margin="8,8,8,12" Style="{StaticResource Nocturne.Styles.TextBlock.Eyebrow}" Text="LIBRARY" />
            <ListBox x:Name="Navigation" Style="{StaticResource Nocturne.Styles.ListBox.Navigation}" SelectedIndex="0"
                     SelectionChanged="OnNavigationChanged" AutomationProperties.Name="Library">
                <ListBoxItem AutomationProperties.Name="Controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Nocturne.Icons.Grid}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="More controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Nocturne.Icons.Folder}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="More controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Custom controls">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Nocturne.Icons.Components}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Custom controls" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Data grid">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Nocturne.Icons.Database}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Data grid" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Layers and colours">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:StrokeIcon Width="18" Height="18" Data="{StaticResource Nocturne.Icons.Layers}" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Layers &amp; colours" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Icons">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Nocturne.Styles.IconTile.Small}">
                            <nc:NocturneIcon Width="18" Height="18" Kind="Star" />
                        </ContentControl>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Icons" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Pages -->
        <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,12,32,32">
                <views:ControlsPage x:Name="ControlsPage" />
                <views:MoreControlsPage x:Name="MoreControlsPage" Visibility="Collapsed" />
                <views:CustomControlsPage x:Name="CustomControlsPage" Visibility="Collapsed" />
                <views:GridPage x:Name="GridPage" Visibility="Collapsed" />
                <views:TokensPage x:Name="TokensPage" Visibility="Collapsed" />
                <views:IconsPage x:Name="IconsPage" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</nc:NocturneWindow>
