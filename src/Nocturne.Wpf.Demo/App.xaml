<Application x:Class="Nocturne.Wpf.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nocturne.Wpf;component/Styles/Nocturne.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Demo layout -->
            <Style x:Key="Demo.Card" TargetType="HeaderedContentControl" BasedOn="{StaticResource Nocturne.Styles.Card}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <!-- A key / value line, as in the tab panels -->
            <Style x:Key="Demo.Key" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Secondary}" />
            </Style>
            <Style x:Key="Demo.Value" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <!-- A round colour dot that picks the accent; a white ring marks the chosen one -->
            <Style x:Key="Demo.AccentSwatch" TargetType="RadioButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource Nocturne.Brushes.Focus}" StrokeThickness="2" Opacity="0" />
                                <Ellipse x:Name="Dot" Margin="4.5" Fill="{TemplateBinding Background}" Stroke="#33FFFFFF" StrokeThickness="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gallery sample (Views/GalleryPage): a card on the window ground, 16px of ground around it.
                 The AdornerDecorator keeps adorners inside the sample, so they are rendered too. -->
            <Style x:Key="Demo.Sample" TargetType="ContentControl">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Width" Value="472" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <AdornerDecorator>
                                <Border Margin="16" Style="{StaticResource Nocturne.Styles.Border.Card}">
                                    <ContentPresenter />
                                </Border>
                            </AdornerDecorator>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Demo.StateLabel" TargetType="TextBlock" BasedOn="{StaticResource Nocturne.Styles.TextBlock.Mono}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
