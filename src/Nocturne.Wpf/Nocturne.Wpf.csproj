<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nocturne.Wpf</RootNamespace>
    <AssemblyName>Nocturne.Wpf</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package. The release workflow overrides Version from the git tag (v1.2.3 -> 1.2.3). -->
  <PropertyGroup>
    <PackageId>Nocturne.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Authors>Martin Kirk</Authors>
    <Copyright>Copyright (c) 2026 Martin Kirk</Copyright>
    <Description>Nocturne: a dark theme for WPF on .NET 10+. Windows 11 Acrylic, Mica or Mica Alt shows through a tinted window, with translucent cards and styles for the standard controls.</Description>
    <PackageTags>wpf;theme;mica;acrylic;nocturne;dark;controls;styles</PackageTags>
    <PackageProjectUrl>https://github.com/Montago/NocturneTheme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Montago/NocturneTheme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- MIT, except the icons (Material Design Icons, Apache License 2.0) and the font (Inter, SIL OFL 1.1); see NOTICE.md -->
    <PackageLicenseExpression>MIT AND Apache-2.0 AND OFL-1.1</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drawn by tools/generate_icon.ps1 -->
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
    <!-- The icons are Material Design Icons (Apache License 2.0) -->
    <None Include="..\..\icons\LICENSE" Pack="true" PackagePath="\icons\" />
    <None Include="..\..\icons\LICENSE-2.0.txt" Pack="true" PackagePath="\icons\" />
    <!-- The font is Inter (SIL Open Font License 1.1) -->
    <None Include="..\..\fonts\inter\LICENSE.txt" Pack="true" PackagePath="\fonts\" Link="Fonts\LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter, one static file per weight: pack://application:,,,/Nocturne.Wpf;component/Fonts/#Inter -->
    <Resource Include="..\..\fonts\inter\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
