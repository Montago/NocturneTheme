<!--
    TimePicker, ColorPicker, AutoSuggestBox and SearchComboBox: fields with a drop-down. Each is the
    TextBox / ComboBox field (dark glass, light bottom edge, accent line in focus, red with an
    error) over a popup surface with a plain list (Nocturne.Styles.ListBox.Popup).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls"
                    xmlns:h="clr-namespace:Nocturne.Wpf.Helpers">

    <h:ColorToBrushConverter x:Key="Nocturne.Converters.ColorToBrush" />
    <h:ColorToHexConverter x:Key="Nocturne.Converters.ColorToHex" />

    <!-- The list in a drop-down: rows as in the ComboBox's -->
    <Style x:Key="Nocturne.Styles.ListBoxItem.Popup" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="HoverBg" CornerRadius="6" Background="{DynamicResource Nocturne.Brushes.Option.Hover}" Visibility="Collapsed" />
                        <Border x:Name="SelectedBg" CornerRadius="6" Background="{DynamicResource Nocturne.Brushes.Option.Selected}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.ListBox.Popup" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nocturne.Styles.ListBoxItem.Popup}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Background="{TemplateBinding Background}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small toggle at the end of a field (TimePicker clock) -->
    <Style x:Key="Nocturne.Styles.ToggleButton.Field" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The field all four share -->
    <Style x:Key="Nocturne.Styles.Picker.Base" TargetType="Control">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource Nocturne.Templates.ValidationError}" />
    </Style>

    <!-- TimePicker: type a time or pick one from the list under the clock button -->
    <Style TargetType="c:TimePicker" BasedOn="{StaticResource Nocturne.Styles.Picker.Base}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:TimePicker">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <ToggleButton x:Name="DropButton" DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.ToggleButton.Field}" AutomationProperties.Name="Show times"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <c:StrokeIcon Width="18" Height="18" Data="{DynamicResource Nocturne.Icons.Clock}" />
                            </ToggleButton>
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                                <TextBox x:Name="PART_TextBox" Style="{DynamicResource Nocturne.Styles.TextBox.Inner}" Padding="{TemplateBinding Padding}"
                                         Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                         AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                            </Grid>
                        </DockPanel>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}" HorizontalOffset="-14" VerticalOffset="2"
                               StaysOpen="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Template="{DynamicResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False">
                                <ListBox x:Name="PART_List" Style="{StaticResource Nocturne.Styles.ListBox.Popup}" MaxHeight="264" MinWidth="{Binding ActualWidth, ElementName=Root}"
                                         ItemStringFormat="{}{0:hh\:mm}" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_TextBox" Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="DropButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ColorPicker: the colour and its hex code in the ComboBox field; a grid of rounded swatches below -->
    <Style x:Key="Nocturne.Styles.ColorPicker.Swatch" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource Nocturne.Converters.ColorToHex}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Width="26" Height="26" Background="Transparent">
                        <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" />
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="#26FFFFFF"
                                Background="{Binding Converter={StaticResource Nocturne.Converters.ColorToBrush}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Toggle.Border}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:ColorPicker" BasedOn="{StaticResource Nocturne.Styles.Picker.Base}">
        <Setter Property="Padding" Value="10,0,36,0" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ColorPicker">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <c:StrokeIcon x:Name="Chevron" Width="16" Height="16" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      StrokeThickness="1.8" Data="{DynamicResource Nocturne.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                        <ToggleButton Style="{DynamicResource Nocturne.Styles.ComboBox.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#33FFFFFF"
                                    Background="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Nocturne.Converters.ColorToBrush}}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Nocturne.Fonts.Family.Mono}" FontSize="{DynamicResource Nocturne.Font.Size.Caption}"
                                       Text="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Nocturne.Converters.ColorToHex}}" />
                        </StackPanel>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}" HorizontalOffset="-14" VerticalOffset="2"
                               StaysOpen="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Template="{DynamicResource Nocturne.Templates.PopupSurface}" Padding="7" Focusable="False" IsTabStop="False">
                                <ListBox x:Name="PART_Palette" Style="{StaticResource Nocturne.Styles.ListBox.Popup}" ItemsSource="{TemplateBinding Palette}"
                                         ItemContainerStyle="{StaticResource Nocturne.Styles.ColorPicker.Swatch}" ScrollViewer.CanContentScroll="False"
                                         AutomationProperties.Name="Colours">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="256" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        AutoSuggestBox: the TextBox itself (ControlHelper.Placeholder, Icon and ClearButton pass
        through) with the matches in a drop-down while you type.
    -->
    <Style TargetType="c:AutoSuggestBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AutoSuggestBox">
                    <Grid>
                        <TextBox x:Name="PART_TextBox" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
                                 h:ControlHelper.Placeholder="{TemplateBinding h:ControlHelper.Placeholder}" h:ControlHelper.Icon="{TemplateBinding h:ControlHelper.Icon}"
                                 h:ControlHelper.ClearButton="{TemplateBinding h:ControlHelper.ClearButton}" h:ControlHelper.HasError="{TemplateBinding h:ControlHelper.HasError}"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" HorizontalOffset="-14" VerticalOffset="2"
                               StaysOpen="False" PopupAnimation="Fade">
                            <ContentControl Template="{DynamicResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False">
                                <ListBox x:Name="PART_List" Style="{StaticResource Nocturne.Styles.ListBox.Popup}" MaxHeight="264"
                                         MinWidth="{Binding ActualWidth, ElementName=PART_TextBox}" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SearchComboBox: the editable ComboBox; the drop-down is a virtualized list filtered by what you type -->
    <Style TargetType="c:SearchComboBox" BasedOn="{StaticResource Nocturne.Styles.Picker.Base}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SearchComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <c:StrokeIcon x:Name="Chevron" Width="16" Height="16" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      StrokeThickness="1.8" Data="{DynamicResource Nocturne.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"
                                      RenderTransformOrigin="0.5,0.5">
                            <c:StrokeIcon.RenderTransform>
                                <RotateTransform />
                            </c:StrokeIcon.RenderTransform>
                        </c:StrokeIcon>
                        <ToggleButton x:Name="Toggle" Style="{DynamicResource Nocturne.Styles.ComboBox.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <TextBlock x:Name="Placeholder" Margin="12,0,36,0" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                        <TextBox x:Name="PART_TextBox" Margin="10,1,36,1" Style="{DynamicResource Nocturne.Styles.TextBox.Inner}" Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}" HorizontalOffset="-14" VerticalOffset="2"
                               Focusable="False" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Template="{DynamicResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False">
                                <Grid MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ListBox x:Name="PART_List" Style="{StaticResource Nocturne.Styles.ListBox.Popup}" Focusable="False"
                                             DisplayMemberPath="{TemplateBinding DisplayMemberPath}" ItemTemplate="{TemplateBinding ItemTemplate}"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                                    <TextBlock x:Name="NoMatches" Margin="10,8" Text="{TemplateBinding NoMatchesText}" Visibility="Collapsed"
                                               Foreground="{DynamicResource Nocturne.Brushes.Text.Hint}" />
                                </Grid>
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_List" Property="HasItems" Value="False">
                            <Setter TargetName="NoMatches" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
