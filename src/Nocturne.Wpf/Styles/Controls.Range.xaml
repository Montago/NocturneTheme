<!--
    ScrollViewer / ScrollBar (thin rounded bars without arrows that widen under the mouse; the
    mouse wheel passes on to an outer scroll viewer when this one cannot scroll), Slider and
    ProgressBar (with an indeterminate runner), ProgressRing, RangeSlider (two Slider thumbs) and
    Rating.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls"
                    xmlns:h="clr-namespace:Nocturne.Wpf.Helpers">

    <!-- Scroll bars -->
    <Style x:Key="Nocturne.Styles.ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The thumb fills the whole width of the bar, so it is easy to grab; only the rounded bar in
        its middle is drawn. Over the scroll bar, track and thumb widen from 6 to 10px.
    -->
    <Style x:Key="Nocturne.Styles.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.ScrollBar.Thumb}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bar" Property="Width" Value="10" />
                            <Setter TargetName="Bar" Property="CornerRadius" Value="5" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.ScrollBar.Thumb.Hover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.ScrollBar.Thumb.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nocturne.Styles.ScrollBar.Thumb.Horizontal" TargetType="Thumb" BasedOn="{StaticResource Nocturne.Styles.ScrollBar.Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bar" Property="Height" Value="10" />
                            <Setter TargetName="Bar" Property="CornerRadius" Value="5" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Nocturne.Templates.ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="TrackBar" Width="6" Margin="0,4" CornerRadius="3" HorizontalAlignment="Center" Background="{DynamicResource Nocturne.Brushes.ScrollBar.Track}" />
            <Track x:Name="PART_Track" Margin="0,4" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Nocturne.Styles.ScrollBar.PageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Nocturne.Styles.ScrollBar.PageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="24" Style="{StaticResource Nocturne.Styles.ScrollBar.Thumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBar" Property="Width" Value="10" />
                <Setter TargetName="TrackBar" Property="CornerRadius" Value="5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Nocturne.Templates.ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="TrackBar" Height="6" Margin="4,0" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource Nocturne.Brushes.ScrollBar.Track}" />
            <Track x:Name="PART_Track" Margin="4,0" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Nocturne.Styles.ScrollBar.PageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Nocturne.Styles.ScrollBar.PageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="24" Style="{StaticResource Nocturne.Styles.ScrollBar.Thumb.Horizontal}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBar" Property="Height" Value="10" />
                <Setter TargetName="TrackBar" Property="CornerRadius" Value="5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 18px wide: the bar sits clear of the window's 6px resize border when it runs along the edge -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template" Value="{StaticResource Nocturne.Templates.ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Template" Value="{StaticResource Nocturne.Templates.ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="h:ScrollViewerHelper.ChainMouseWheel" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: a 4px track, the filled part in the light accent, a 20px thumb with a pale ring -->
    <Style x:Key="Nocturne.Styles.Slider.Fill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Slider}}" Value="Vertical">
                            <Setter TargetName="Bar" Property="Height" Value="NaN" />
                            <Setter TargetName="Bar" Property="Width" Value="4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Nocturne.Styles.Slider.Rest" TargetType="RepeatButton" BasedOn="{StaticResource Nocturne.Styles.Slider.Fill}">
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Slider.Track}" />
    </Style>

    <Style x:Key="Nocturne.Styles.Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="Black" Margin="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.45" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Knob" Fill="{DynamicResource Nocturne.Brushes.Accent}" Stroke="{DynamicResource Nocturne.Brushes.Slider.Thumb.Border}" StrokeThickness="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Nocturne.Styles.FocusVisual}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Nocturne.Styles.Slider.Fill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Nocturne.Styles.Slider.Rest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Nocturne.Styles.Slider.Thumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="22" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ProgressBar: a 6px rounded track; IsIndeterminate runs a bar across in 1.6 s -->
    <Style TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Progress.Track}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        <!-- The runner: a brush with a hard-edged 35% stripe, slid across by its RelativeTransform -->
                        <Rectangle x:Name="Runner" RadiusX="3" RadiusY="3" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.35" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="0" Color="{DynamicResource Nocturne.Colors.Accent.Light}" />
                                    <GradientStop Offset="0.35" Color="{DynamicResource Nocturne.Colors.Accent.Light}" />
                                    <GradientStop Offset="0.35" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunnerStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner"
                                                         Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.35" To="1" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunnerStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressRing: a quarter arc in the light accent runs round a faint track once a second; size it with Width and Height -->
    <Style TargetType="c:ProgressRing">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Progress.Track}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ProgressRing">
                    <Viewbox x:Name="Root" Stretch="Uniform">
                        <Grid Width="32" Height="32">
                            <!-- An Ellipse strokes inside its bounds (centre line at radius 12.5); a Path strokes on its line, so the arc uses radius 12.5 too -->
                            <Ellipse Margin="2" Stroke="{TemplateBinding Background}" StrokeThickness="3" />
                            <Path x:Name="Arc" Width="32" Height="32" Data="M16,3.5 A12.5,12.5 0 0 1 28.5,16" Stroke="{TemplateBinding Foreground}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Arc" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round keyboard-focus ring, for the RangeSlider thumbs -->
    <Style x:Key="Nocturne.Styles.FocusVisual.Round">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-4" StrokeThickness="2" Stroke="{DynamicResource Nocturne.Brushes.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RangeSlider: the Slider's track and thumbs, with the light accent between the two thumbs -->
    <Style TargetType="c:RangeSlider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:RangeSlider">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" Margin="10,0" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Nocturne.Brushes.Slider.Track}" />
                        <Canvas x:Name="PART_Track">
                            <Border x:Name="PART_Fill" Canvas.Top="9" Height="4" CornerRadius="2" Background="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                            <Thumb x:Name="PART_LowerThumb" Canvas.Top="1" Style="{StaticResource Nocturne.Styles.Slider.Thumb}" Focusable="True"
                                   FocusVisualStyle="{StaticResource Nocturne.Styles.FocusVisual.Round}" AutomationProperties.Name="Lower value" />
                            <Thumb x:Name="PART_UpperThumb" Canvas.Top="1" Style="{StaticResource Nocturne.Styles.Slider.Thumb}" Focusable="True"
                                   FocusVisualStyle="{StaticResource Nocturne.Styles.FocusVisual.Round}" AutomationProperties.Name="Upper value" />
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rating: the stars are drawn by the control (light accent when on, dark outline when off) -->
    <Style TargetType="c:Rating">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Nocturne.Styles.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Rating">
                    <StackPanel x:Name="PART_Host" Orientation="Horizontal" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
