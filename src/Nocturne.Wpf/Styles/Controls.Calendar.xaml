<!--
    Calendar and DatePicker. The calendar is a sunken glass panel: month and year on the left,
    arrows on the right, rounded day cells; today has an accent ring, the selected day the accent
    fill. In a DatePicker's drop-down (Nocturne.Styles.Calendar.Popup) it takes the popup surface and
    shadow. The DatePicker field is the TextBox field with a calendar button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls"
                    xmlns:h="clr-namespace:Nocturne.Wpf.Helpers">

    <!-- A day in the month view -->
    <Style x:Key="Nocturne.Styles.CalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="h:FocusHelper.TracksKeyboardFocus" Value="True" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverBg" CornerRadius="8" Background="{DynamicResource Nocturne.Brushes.Item.Hover}" Opacity="0" />
                        <Border x:Name="TodayRing" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <Border x:Name="SelectedBg" CornerRadius="8" Background="{DynamicResource Nocturne.Brushes.Accent}" Visibility="Collapsed" />
                        <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Nocturne.Brushes.Focus}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <!-- A blacked-out day is struck through -->
                        <Path x:Name="Blackout" Width="16" Height="16" Stretch="Fill" Data="M0,16 L16,0" StrokeThickness="1.5"
                              Stroke="{DynamicResource Nocturne.Brushes.Text.Placeholder}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="TodayRing" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Accent.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverBg" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Blackout" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                        </Trigger>
                        <Trigger Property="h:FocusHelper.IsKeyboardFocusVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A month in the year view, a year in the decade view -->
    <Style x:Key="Nocturne.Styles.CalendarButton" TargetType="CalendarButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="h:FocusHelper.TracksKeyboardFocus" Value="True" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverBg" CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Item.Hover}" Opacity="0" />
                        <Border x:Name="SelectedBg" CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Accent}" Visibility="Collapsed" />
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Nocturne.Brushes.Focus}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverBg" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="h:FocusHelper.IsKeyboardFocusVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Previous / next arrows -->
    <Style x:Key="Nocturne.Styles.Calendar.NavButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "November 2026": switches to the year and decade views -->
    <Style x:Key="Nocturne.Styles.Calendar.HeaderButton" TargetType="Button" BasedOn="{StaticResource Nocturne.Styles.Calendar.NavButton}">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.CalendarItem" TargetType="CalendarItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Margin="0,2,0,6" HorizontalAlignment="Center" Text="{Binding}"
                                       FontSize="{DynamicResource Nocturne.Font.Size.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Nocturne.Brushes.Text.Hint}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.Calendar.NavButton}" AutomationProperties.Name="Next">
                                <c:StrokeIcon Width="16" Height="16" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.ChevronRight}" />
                            </Button>
                            <Button x:Name="PART_PreviousButton" DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.Calendar.NavButton}" AutomationProperties.Name="Previous">
                                <c:StrokeIcon Width="16" Height="16" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.ChevronLeft}" />
                            </Button>
                            <Button x:Name="PART_HeaderButton" HorizontalAlignment="Left" Style="{StaticResource Nocturne.Styles.Calendar.HeaderButton}" />
                        </DockPanel>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" HorizontalAlignment="Center" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource Nocturne.Styles.CalendarItem}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Nocturne.Styles.CalendarDayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Nocturne.Styles.CalendarButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Shadow" Margin="1" CornerRadius="12" Background="Black" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"
                                          Background="Transparent" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.HasShadow" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The calendar in a DatePicker's drop-down; the outer margin leaves room for the shadow -->
    <Style x:Key="Nocturne.Styles.Calendar.Popup" TargetType="Calendar" BasedOn="{StaticResource {x:Type Calendar}}">
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Popup.Border}" />
        <Setter Property="Margin" Value="14,4,14,28" />
        <Setter Property="h:ControlHelper.HasShadow" Value="True" />
    </Style>

    <Style TargetType="CalendarDayButton" BasedOn="{StaticResource Nocturne.Styles.CalendarDayButton}" />
    <Style TargetType="CalendarButton" BasedOn="{StaticResource Nocturne.Styles.CalendarButton}" />
    <Style TargetType="CalendarItem" BasedOn="{StaticResource Nocturne.Styles.CalendarItem}" />

    <!-- DatePicker -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked" />
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- TextBoxBase applies Padding to the text itself; the watermark gets it here, plus the 2px text inset -->
                        <ContentControl x:Name="PART_Watermark" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Opacity="0" Focusable="False" IsHitTestVisible="False"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{DynamicResource Nocturne.Brushes.Text.Placeholder}" />
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.DatePicker.Button" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="AutomationProperties.Name" Value="Show calendar" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <c:StrokeIcon Width="18" Height="18" Data="{DynamicResource Nocturne.Icons.Calendar}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource Nocturne.Styles.Calendar.Popup}" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource Nocturne.Templates.NoErrorAdorner}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <Button x:Name="PART_Button" DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.DatePicker.Button}" />
                            <DatePickerTextBox x:Name="PART_TextBox" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                               HorizontalOffset="-14" VerticalOffset="2" StaysOpen="False"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
