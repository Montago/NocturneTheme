<!--
    ContextMenu, Menu, MenuItem and ToolTip: dark, nearly opaque popups with rounded corners and
    a soft shadow. A menu item shows a stroke icon from ControlHelper.Icon (or its Icon) and its
    InputGestureText on the right. ToolBar and ToolBarTray (the styles ToolBar gives its buttons,
    combo boxes, text boxes and check boxes live in the files of their base styles).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls"
                    xmlns:h="clr-namespace:Nocturne.Wpf.Helpers">

    <!-- The popup surface; the outer margin leaves room for the shadow -->
    <ControlTemplate x:Key="Nocturne.Templates.PopupSurface" TargetType="ContentControl">
        <Grid Margin="14,4,14,28">
            <Border Margin="1" CornerRadius="10" Background="Black">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.45" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="10" Background="{DynamicResource Nocturne.Brushes.Popup}" BorderBrush="{DynamicResource Nocturne.Brushes.Popup.Border}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Nocturne.Templates.MenuItem" TargetType="MenuItem">
        <Grid x:Name="Root" MinHeight="36" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HoverBg" CornerRadius="6" Background="{DynamicResource Nocturne.Brushes.Option.Hover}" Visibility="Collapsed" />
            <Grid x:Name="Row" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGesture" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconHost" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!-- A larger icon ({nc:Icon …} is 20px) is scaled down to the 16px slot -->
                    <Viewbox StretchDirection="DownOnly">
                        <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" />
                    </Viewbox>
                    <c:StrokeIcon x:Name="Glyph" Width="16" Height="16" Data="{TemplateBinding h:ControlHelper.Icon}" Foreground="{TemplateBinding Foreground}" />
                    <c:StrokeIcon x:Name="CheckMark" Width="16" Height="16" StrokeThickness="2.2" Visibility="Collapsed"
                                  Data="{DynamicResource Nocturne.Icons.Check}" Foreground="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                </Grid>
                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                <TextBlock x:Name="Gesture" Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"
                           FontSize="{DynamicResource Nocturne.Font.Size.Small}" Foreground="{DynamicResource Nocturne.Brushes.Shortcut}" />
                <c:StrokeIcon x:Name="Arrow" Grid.Column="3" Width="14" Height="14" Margin="10,0,0,0" StrokeThickness="2" Visibility="Collapsed"
                              Data="{DynamicResource Nocturne.Icons.ChevronRight}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-8" VerticalOffset="-9" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentControl Template="{StaticResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False"
                                Foreground="{DynamicResource Nocturne.Brushes.Text}" FontSize="{DynamicResource Nocturne.Font.Size.Default}">
                    <ScrollViewer Focusable="False" CanContentScroll="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                    </ScrollViewer>
                </ContentControl>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="h:ControlHelper.Icon" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Icon" Value="{x:Null}" />
                    <Condition Property="h:ControlHelper.Icon" Value="{x:Null}" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Root" Property="MinHeight" Value="32" />
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-14" />
                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Root" Property="MinHeight" Value="32" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HoverBg" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="HoverBg" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Nocturne.Styles.FocusVisual.Inset}" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template" Value="{StaticResource Nocturne.Templates.MenuItem}" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="HorizontalOffset" Value="-14" />
        <Setter Property="VerticalOffset" Value="-4" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <ContentControl Template="{StaticResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The right-click menu of the text fields (TextBox, RichTextBox, the editable ComboBox,
        NumericUpDown, DatePicker): Undo, Cut, Copy, Paste and Select all with the theme's line icons.
        ContextMenuHelper.TargetsPlacement sends the commands to the field the menu was opened on, so
        Cut and Copy are dimmed without a selection. A read-only field shows only Copy and Select all. PasswordBox offers Paste only.
        x:Shared False: every field gets its own menu. A field with spell checking on keeps WPF's own
        menu, which lists the suggestions.
    -->
    <!-- Commands that change the text: left out on a read-only field -->
    <Style x:Key="Nocturne.Styles.MenuItem.TextEdit" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PlacementTarget.IsReadOnly, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Nocturne.Styles.Separator.TextEdit" TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PlacementTarget.IsReadOnly, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ContextMenu x:Key="Nocturne.ContextMenu.Text" x:Shared="False" h:ContextMenuHelper.TargetsPlacement="True">
        <MenuItem Style="{StaticResource Nocturne.Styles.MenuItem.TextEdit}" Command="ApplicationCommands.Undo" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.Undo}" />
        <Separator Style="{StaticResource Nocturne.Styles.Separator.TextEdit}" />
        <MenuItem Style="{StaticResource Nocturne.Styles.MenuItem.TextEdit}" Command="ApplicationCommands.Cut" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.Cut}" />
        <MenuItem Command="ApplicationCommands.Copy" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.Copy}" />
        <MenuItem Style="{StaticResource Nocturne.Styles.MenuItem.TextEdit}" Command="ApplicationCommands.Paste" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.Paste}" />
        <Separator />
        <MenuItem Command="ApplicationCommands.SelectAll" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.SelectAll}" />
    </ContextMenu>

    <ContextMenu x:Key="Nocturne.ContextMenu.Password" x:Shared="False" h:ContextMenuHelper.TargetsPlacement="True">
        <MenuItem Command="ApplicationCommands.Paste" h:ControlHelper.Icon="{DynamicResource Nocturne.Icons.Paste}" />
    </ContextMenu>

    <Style TargetType="Menu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalOffset" Value="-14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ContentControl Template="{StaticResource Nocturne.Templates.PopupSurface}" Padding="{TemplateBinding Padding}" Focusable="False" IsTabStop="False">
                        <ContentPresenter />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ToolBar: a glass strip with a dotted grip, subtle buttons and a chevron for the items that do
        not fit (they open in the popup surface).
    -->
    <Style x:Key="Nocturne.Styles.ToolBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Background="Transparent">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Nocturne.Brushes.Text.Hint}" Opacity="0.7"
                              Data="M0,0h2v2h-2z M4,0h2v2h-2z M0,5h2v2h-2z M4,5h2v2h-2z M0,10h2v2h-2z M4,10h2v2h-2z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.ToolBar.Overflow" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="ToolTip" Value="More" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static ToolBar.MenuStyleKey}" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}" />

    <Style TargetType="ToolBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Surface1.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Thumb x:Name="ToolBarThumb" DockPanel.Dock="Left" Margin="0,0,2,0" Style="{StaticResource Nocturne.Styles.ToolBar.Thumb}" />
                            <Grid x:Name="OverflowGrid" DockPanel.Dock="Right" Margin="2,0,0,0">
                                <ToggleButton x:Name="OverflowButton" ClickMode="Press" Visibility="Collapsed" Style="{StaticResource Nocturne.Styles.ToolBar.Overflow}"
                                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Popup x:Name="OverflowPopup" AllowsTransparency="True" Focusable="False" Placement="Bottom" HorizontalOffset="-14" StaysOpen="False"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                       PlacementTarget="{Binding ElementName=OverflowButton}" IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ContentControl Template="{StaticResource Nocturne.Templates.PopupSurface}" Padding="4" Focusable="False" IsTabStop="False"
                                                    Foreground="{DynamicResource Nocturne.Brushes.Text}">
                                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="200" Focusable="True" FocusVisualStyle="{x:Null}"
                                                              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ContentControl>
                                </Popup>
                            </Grid>
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="True">
                            <Setter TargetName="OverflowButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ToolBarTray.IsLocked" Value="True">
                            <Setter TargetName="ToolBarThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="ToolBarThumb" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="ToolBarThumb" Property="Margin" Value="0,0,0,2" />
                            <Setter TargetName="ToolBarThumb" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OverflowGrid" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="OverflowGrid" Property="Margin" Value="0,2,0,0" />
                            <Setter TargetName="OverflowButton" Property="Width" Value="NaN" />
                            <Setter TargetName="OverflowButton" Property="Height" Value="28" />
                            <Setter TargetName="OverflowPopup" Property="Placement" Value="Right" />
                            <Setter TargetName="PART_ToolBarPanel" Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
