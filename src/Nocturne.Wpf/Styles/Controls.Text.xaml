<!--
    TextBox, PasswordBox, RichTextBox, Label. A field is a dark, slightly sunken glass strip with a lighter
    bottom edge; keyboard focus draws a 2px accent line along the bottom, an error a red one.
    ControlHelper.Placeholder shows hint text, ControlHelper.Icon an icon on the left
    (Nocturne.Styles.TextBox.Search sets the magnifier), ControlHelper.ClearButton an × that empties
    the box, PasswordBoxHelper.CanReveal an eye button. NumericUpDown is the same field with step
    buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls"
                    xmlns:h="clr-namespace:Nocturne.Wpf.Helpers"
                    xmlns:nc="urn:nocturne-wpf">

    <!-- The look comes from the template; keep WPF's red adorner away -->
    <ControlTemplate x:Key="Nocturne.Templates.NoErrorAdorner">
        <AdornedElementPlaceholder />
    </ControlTemplate>

    <!--
        Validation.ErrorTemplate of the fields: the field draws its own red frame (Validation.HasError
        in its template); while it has the keyboard focus or the mouse, a callout under it shows the
        first error message. Nocturne.Templates.NoErrorAdorner leaves the callout out, for a form
        that shows the messages itself.
    -->
    <ControlTemplate x:Key="Nocturne.Templates.ValidationError">
        <Grid>
            <AdornedElementPlaceholder x:Name="Placeholder" />
            <Popup x:Name="Callout" AllowsTransparency="True" Placement="Bottom" HorizontalOffset="-14" VerticalOffset="2"
                   PopupAnimation="Fade" Focusable="False" PlacementTarget="{Binding ElementName=Placeholder}">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AdornedElement.IsKeyboardFocusWithin, ElementName=Placeholder}" Value="True">
                                <Setter Property="IsOpen" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AdornedElement.IsMouseOver, ElementName=Placeholder}" Value="True">
                                <Setter Property="IsOpen" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <ContentControl Template="{DynamicResource Nocturne.Templates.PopupSurface}" Padding="10,8,12,8" Focusable="False" IsTabStop="False">
                    <DockPanel MaxWidth="300">
                        <c:StrokeIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" StrokeThickness="1.8"
                                      Data="{DynamicResource Nocturne.Icons.Error}" Foreground="{DynamicResource Nocturne.Brushes.Error}" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="{DynamicResource Nocturne.Fonts.Family}"
                                   FontSize="{DynamicResource Nocturne.Font.Size.Caption}" Foreground="{DynamicResource Nocturne.Brushes.Error.Text}"
                                   Text="{Binding AdornedElement.(Validation.Errors)/ErrorContent, ElementName=Placeholder}" />
                    </DockPanel>
                </ContentControl>
            </Popup>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Nocturne.Styles.Field.Base" TargetType="Control">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Nocturne.Templates.ValidationError}" />
    </Style>

    <!-- The small subtle buttons inside a field: the TextBox clear button, the NumericUpDown steps -->
    <Style x:Key="Nocturne.Styles.Button.Field" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Nocturne.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <c:StrokeIcon x:Name="Icon" DockPanel.Dock="Left" Width="16" Height="16" Margin="11,0,-4,0" StrokeThickness="2"
                                          Data="{TemplateBinding h:ControlHelper.Icon}" Foreground="{DynamicResource Nocturne.Brushes.Text.Hint}" />
                            <Button x:Name="ClearButton" DockPanel.Dock="Right" Margin="0,0,3,0" Visibility="Collapsed" Style="{StaticResource Nocturne.Styles.Button.Field}"
                                    Command="{x:Static h:ControlHelper.ClearTextCommand}" ToolTip="Clear" AutomationProperties.Name="Clear">
                                <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.Close}" />
                            </Button>
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Nocturne.Brushes.Text.Placeholder}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.ClearButton" Value="True">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search field: magnifier on the left -->
    <Style x:Key="Nocturne.Styles.TextBox.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="h:ControlHelper.Icon" Value="{DynamicResource Nocturne.Icons.Search}" />
    </Style>

    <!-- Multi-line text: text from the top, wraps, scrolls -->
    <Style x:Key="Nocturne.Styles.TextBox.MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- The eye button of a PasswordBox -->
    <Style x:Key="Nocturne.Styles.ToggleButton.Reveal" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="ToolTip" Value="Show password" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <c:StrokeIcon Width="18" Height="18" Data="{DynamicResource Nocturne.Icons.Eye}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Item.Selected}" />
                            <Setter Property="ToolTip" Value="Hide password" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource Nocturne.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="h:PasswordBoxHelper.IsMonitoring" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <ToggleButton x:Name="Reveal" DockPanel.Dock="Right" Style="{StaticResource Nocturne.Styles.ToggleButton.Reveal}" Visibility="Collapsed"
                                          IsChecked="{Binding (nc:PasswordBoxHelper.IsRevealed), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Nocturne.Brushes.Text.Placeholder}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <TextBlock x:Name="Revealed" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:PasswordBoxHelper.RevealedText}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:PasswordBoxHelper.CanReveal" Value="True">
                            <Setter TargetName="Reveal" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:PasswordBoxHelper.IsRevealed" Value="True">
                            <Setter TargetName="Revealed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="h:PasswordBoxHelper.HasPassword" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text.Label}" />
        <Setter Property="Padding" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NumericUpDown: the field with step buttons at the end; the text box inside has no look of its own -->
    <Style x:Key="Nocturne.Styles.TextBox.Inner" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.RepeatButton.Field" TargetType="RepeatButton" BasedOn="{StaticResource Nocturne.Styles.Button.Field}">
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="60" />
    </Style>

    <Style TargetType="c:NumericUpDown" BasedOn="{StaticResource Nocturne.Styles.Field.Base}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NumericUpDown">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <StackPanel x:Name="Steps" DockPanel.Dock="Right" Margin="0,0,3,0" Orientation="Horizontal">
                                <RepeatButton x:Name="PART_Down" Style="{StaticResource Nocturne.Styles.RepeatButton.Field}" AutomationProperties.Name="Decrease">
                                    <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.ChevronDown}" />
                                </RepeatButton>
                                <RepeatButton x:Name="PART_Up" Style="{StaticResource Nocturne.Styles.RepeatButton.Field}" AutomationProperties.Name="Increase">
                                    <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Nocturne.Icons.ChevronUp}" />
                                </RepeatButton>
                            </StackPanel>
                            <TextBox x:Name="PART_TextBox" Style="{StaticResource Nocturne.Styles.TextBox.Inner}" Padding="{TemplateBinding Padding}"
                                     Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HideUpDownButtons" Value="True">
                            <Setter TargetName="Steps" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Steps" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The TextBox ToolBar gives its children -->
    <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!--
        RichTextBox: the multi-line field. A FlowDocument does not take the box's font (it would be
        justified Georgia), so the document gets the theme font, left-aligned, and paragraphs 8px
        apart instead of a blank line.
    -->
    <Style TargetType="RichTextBox" BasedOn="{StaticResource Nocturne.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Nocturne.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding BorderThickness}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Error}" />
