<!-- Type: Inter, embedded in the library (fonts/inter, SIL OFL 1.1), with Segoe UI behind it for
     characters Inter lacks. Apps can override Nocturne.Fonts.Family (the design used Figtree). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Resolved against this file's address (no pack://application:,,, here: a doubled comma in a
         family list is a comma inside a name) -->
    <FontFamily x:Key="Nocturne.Fonts.Family">/Nocturne.Wpf;component/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Nocturne.Fonts.Family.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Nocturne.Font.Size.Title">30</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.Subtitle">20</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.ListTitle">16</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.Default">14</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.Caption">13</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.Small">12</sys:Double>
    <sys:Double x:Key="Nocturne.Font.Size.Tag">11</sys:Double>
</ResourceDictionary>
