<!--
    Nocturne colours. Every surface is a plain SolidColorBrush with alpha over the window's
    backdrop: there is no blur inside the window. Reference them with DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Accent (blue). NocturneTheme.SetAccent switches the accent brushes, Text.OnAccent, the
        primary button, Popup, the window's Tint and Fallback and the Accent title bar to another hue.
    -->

    <Color x:Key="Nocturne.Colors.Accent">#FF1F78D1</Color>
    <Color x:Key="Nocturne.Colors.Accent.Light">#FF4DA3FF</Color>
    <SolidColorBrush x:Key="Nocturne.Brushes.Accent" Color="#FF1F78D1" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Accent.Light" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Accent.Text" Color="#FF9CCBFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Accent.Text.Hover" Color="#FFC9E2FF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Text" Color="#FFF2F6F3" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.Secondary" Color="#C7EBF2ED" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.Label" Color="#D6EEF4F0" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.Hint" Color="#BDEBF2ED" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.Placeholder" Color="#9EEBF2ED" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.Selected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Text.OnAccent" Color="#FFFFFFFF" />

    <!-- Glass surfaces -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface1" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface1.Border" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface1.Highlight" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface2" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface.Hover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Surface.Sunken" Color="#1A000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Stroke" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Stroke.Subtle" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Divider" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Focus" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <LinearGradientBrush x:Key="Nocturne.Brushes.Button.Primary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1A6CC0" />
        <GradientStop Offset="1" Color="#FF155FAD" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Nocturne.Brushes.Button.Primary.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1D76CF" />
        <GradientStop Offset="1" Color="#FF1867B9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Primary.Pressed" Color="#FF134F8C" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Primary.Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Primary.Highlight" Color="#33FFFFFF" />
    <!-- Danger: a deep red whatever the accent, darker than the red accent's primary button so the
         two stay apart when the accent is red -->
    <LinearGradientBrush x:Key="Nocturne.Brushes.Button.Danger" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF9E2121" />
        <GradientStop Offset="1" Color="#FF861B1B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Nocturne.Brushes.Button.Danger.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFAB2626" />
        <GradientStop Offset="1" Color="#FF922020" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Danger.Pressed" Color="#FF701616" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Secondary" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Secondary.Hover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Secondary.Pressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Secondary.Border" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Subtle.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Button.Pressed.Text" Color="#CCF2F6F3" />

    <!-- Input fields -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Field" Color="#33000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Field.Hover" Color="#42000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Field.Focus" Color="#4D000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Field.Border" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Field.Border.Bottom" Color="#57FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Field.Border.Focus" Color="#2EFFFFFF" />

    <!-- Check boxes, radio buttons, switches -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Toggle.Fill" Color="#2E000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Toggle.Border" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Toggle.Border.Hover" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Switch.Border" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Switch.Knob" Color="#D9FFFFFF" />

    <!-- Range controls and scroll bars -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Slider.Track" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Slider.Thumb.Border" Color="#FFEAF2EC" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Progress.Track" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.ScrollBar.Track" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.ScrollBar.Thumb" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.ScrollBar.Thumb.Hover" Color="#8CFFFFFF" />

    <!-- Lists, tabs, menus -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Item.Hover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Item.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Item.Selected" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Row.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Row.Selected" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Row.Selected.Hover" Color="#1FFFFFFF" />
    <!-- NocturneGrid: the cells with search hits (their words in Accent.Text) -->
    <SolidColorBrush x:Key="Nocturne.Brushes.DataGrid.SearchHit" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Tile" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Tile.Border" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Tile.Border.Selected" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Tile.Icon" Color="#FFEAF2EC" />
    <SolidColorBrush x:Key="Nocturne.Brushes.TabStrip" Color="#29000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.TabStrip.Border" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Tab.Text" Color="#C7EEF4F0" />
    <SolidColorBrush x:Key="Nocturne.Brushes.DocumentTab.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.DocumentTab.Selected" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Expander.Header" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Expander.Header.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Popup" Color="#F71F2633" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Popup.Border" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Option.Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Option.Selected" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Shortcut" Color="#B8EBF2ED" />

    <!-- Status -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Error" Color="#FFFF8F85" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Error.Text" Color="#FFFFA59C" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Error.Background" Color="#26FF786E" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Warning" Color="#FFFFD27A" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Warning.Background" Color="#26FFC440" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Success" Color="#FF8EF0B8" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Success.Background" Color="#293FD27F" />

    <!-- Window layers, from the bottom: backdrop (or the fallback ground), tint, light -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Window.Fallback" Color="#FF1E2633" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Window.Tint" Color="#FF10161F" />
    <!-- The light as a brush, for own templates. NocturneWindow draws it dithered instead (LightTexture), as a gradient this faint shows bands -->
    <LinearGradientBrush x:Key="Nocturne.Brushes.Window.Light" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#14FFFFFF" />
        <GradientStop Offset="0.38" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <!-- Title bar strips (NocturneWindow.TitleBarStyle Separated and Accent), each with a hairline under it -->
    <SolidColorBrush x:Key="Nocturne.Brushes.TitleBar.Separated" Color="#38000000" />
    <SolidColorBrush x:Key="Nocturne.Brushes.TitleBar.Separated.Border" Color="#14FFFFFF" />
    <LinearGradientBrush x:Key="Nocturne.Brushes.TitleBar.Accent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D1F78D1" />
        <GradientStop Offset="1" Color="#381F78D1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Nocturne.Brushes.TitleBar.Accent.Border" Color="#384DA3FF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Caption.Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Caption.Pressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Close.Hover" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Nocturne.Brushes.Close.Pressed" Color="#FFA82618" />

    <!-- Laid over the page while a dialog is open -->
    <SolidColorBrush x:Key="Nocturne.Brushes.Overlay" Color="#73000000" />
</ResourceDictionary>
