<!--
    NocturneWindow: backdrop (or the opaque fallback), tint and the light from the top-left
    corner, under a 44px title bar with 46 x 32 caption buttons: LeftWindowCommands, icon and title,
    RightWindowCommands, caption buttons. TitleBarStyle puts a strip behind it. Over the content: the Flyouts layer,
    then PART_DialogHost, which dims the page while a NocturneDialog is open.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls">

    <Style x:Key="Nocturne.Styles.Button.WindowCaption" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <Path Width="10" Height="10" Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                              SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Caption.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Caption.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nocturne.Styles.Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Nocturne.Styles.Button.WindowCaption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <Path x:Name="Glyph" Width="10" Height="10" Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                              SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Close.Hover}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nocturne.Brushes.Close.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:NocturneWindow">
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NocturneWindow">
                    <Grid x:Name="PART_Root">
                        <!-- Layers, from the bottom -->
                        <Border x:Name="Fallback" Background="{DynamicResource Nocturne.Brushes.Window.Fallback}" />
                        <Rectangle Fill="{DynamicResource Nocturne.Brushes.Window.Tint}" Opacity="{TemplateBinding TintOpacity}" />
                        <!-- The light from the top-left corner: NocturneWindow draws it dithered for the window's size -->
                        <Image x:Name="PART_Light" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" IsHitTestVisible="False" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- The strip behind the title bar: none (Seamless), or a fill with a hairline under it (TitleBarStyle) -->
                            <Border x:Name="TitleBarBg" Height="{TemplateBinding TitleBarHeight}" Background="Transparent" />
                            <DockPanel x:Name="TitleBar" Height="{TemplateBinding TitleBarHeight}" Background="Transparent">
                                <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="MinButton" Style="{StaticResource Nocturne.Styles.Button.WindowCaption}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                            Content="{DynamicResource Nocturne.Icons.Caption.Minimize}" AutomationProperties.Name="Minimize" />
                                    <Button x:Name="MaxButton" Style="{StaticResource Nocturne.Styles.Button.WindowCaption}" Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                            Content="{DynamicResource Nocturne.Icons.Caption.Maximize}" AutomationProperties.Name="Maximize" />
                                    <Button x:Name="RestoreButton" Style="{StaticResource Nocturne.Styles.Button.WindowCaption}" Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                            Content="{DynamicResource Nocturne.Icons.Caption.Restore}" AutomationProperties.Name="Restore" Visibility="Collapsed" />
                                    <Button x:Name="CloseButton" Style="{StaticResource Nocturne.Styles.Button.WindowClose}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            Content="{DynamicResource Nocturne.Icons.Caption.Close}" AutomationProperties.Name="Close" />
                                </StackPanel>
                                <ContentPresenter x:Name="RightCommands" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding RightWindowCommands}" WindowChrome.IsHitTestVisibleInChrome="True" />
                                <!-- LeftWindowCommands, then a thin divider before the icon and title -->
                                <ContentPresenter x:Name="LeftCommands" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding LeftWindowCommands}" WindowChrome.IsHitTestVisibleInChrome="True" />
                                <Rectangle x:Name="LeftDivider" DockPanel.Dock="Left" Width="1" Height="18" Margin="12,0" VerticalAlignment="Center"
                                           Fill="{DynamicResource Nocturne.Brushes.Divider}" />
                                <StackPanel x:Name="TitleArea" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid x:Name="IconHost" Width="16" Height="16" Margin="0,0,10,0">
                                        <Image x:Name="IconImage" Source="{TemplateBinding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Shown when the window has no Icon -->
                                        <Canvas x:Name="DefaultIcon" Width="16" Height="16" Visibility="Collapsed">
                                            <Rectangle x:Name="DefaultIconFill" Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" RadiusX="4" RadiusY="4" Fill="{DynamicResource Nocturne.Brushes.Accent}" />
                                            <Rectangle Canvas.Left="4.5" Canvas.Top="4.5" Width="7" Height="7" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="1.4" />
                                        </Canvas>
                                    </Grid>
                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource Nocturne.Font.Size.Small}" FontWeight="Medium" />
                                </StackPanel>
                            </DockPanel>

                            <AdornerDecorator Grid.Row="1">
                                <Grid>
                                    <ContentPresenter />
                                    <ContentPresenter Content="{TemplateBinding Flyouts}" ClipToBounds="True" />
                                    <Grid x:Name="PART_DialogHost" Background="{DynamicResource Nocturne.Brushes.Overlay}" Visibility="Collapsed" />
                                </Grid>
                            </AdornerDecorator>
                        </Grid>

                        <ResizeGrip x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False"
                                    WindowChrome.ResizeGripDirection="BottomRight" Opacity="0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LeftWindowCommands" Value="{x:Null}">
                            <Setter TargetName="LeftCommands" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeftDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleArea" Property="Margin" Value="16,0,0,0" />
                        </Trigger>
                        <Trigger Property="TitleBarStyle" Value="Separated">
                            <Setter TargetName="TitleBarBg" Property="Background" Value="{DynamicResource Nocturne.Brushes.TitleBar.Separated}" />
                            <Setter TargetName="TitleBarBg" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.TitleBar.Separated.Border}" />
                            <Setter TargetName="TitleBarBg" Property="BorderThickness" Value="0,0,0,1" />
                        </Trigger>
                        <Trigger Property="TitleBarStyle" Value="Accent">
                            <Setter TargetName="TitleBarBg" Property="Background" Value="{DynamicResource Nocturne.Brushes.TitleBar.Accent}" />
                            <Setter TargetName="TitleBarBg" Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.TitleBar.Accent.Border}" />
                            <Setter TargetName="TitleBarBg" Property="BorderThickness" Value="0,0,0,1" />
                            <!-- The accent square would sink into the accent strip: draw it in the light shade -->
                            <Setter TargetName="DefaultIconFill" Property="Fill" Value="{DynamicResource Nocturne.Brushes.Accent.Light}" />
                        </Trigger>
                        <Trigger Property="IsBackdropActive" Value="True">
                            <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DefaultIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowIcon" Value="False">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMinButton" Value="False">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowMaxRestoreButton" Value="False">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleArea" Property="Opacity" Value="0.6" />
                            <Setter TargetName="CaptionButtons" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Six dots in the bottom-right corner (ResizeMode CanResizeWithGrip) -->
    <Style TargetType="ResizeGrip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGrip">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Path Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Nocturne.Brushes.Text.Hint}"
                              Data="M8,0h2v2h-2z M4,4h2v2h-2z M8,4h2v2h-2z M0,8h2v2h-2z M4,8h2v2h-2z M8,8h2v2h-2z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
