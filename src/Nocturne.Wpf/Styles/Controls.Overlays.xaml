<!--
    NocturneDialog and Flyout: the glass surfaces that sit over the page. Both use the popup surface
    (Nocturne.Brushes.Popup) with a 14px radius and a soft shadow.
    A dialog is centred over the dimmed page and grows in from 96 % in 150 ms; its main button is
    primary, the second one plain. A flyout floats 12px from the edge it slides in from.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:Nocturne.Wpf.Controls">

    <Style TargetType="c:NocturneDialog">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24,22,24,24" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NocturneDialog">
                    <Grid x:Name="Card" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Border Margin="1" CornerRadius="14" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <Grid>
                                <Border CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Nocturne.Brushes.Surface1.Highlight}" />
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Margin="0,0,0,12" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Nocturne.Font.Size.Subtitle}" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button x:Name="PART_Negative" MinWidth="96" Margin="0,0,8,0" Content="{TemplateBinding NegativeText}" />
                                        <Button x:Name="PART_Affirmative" MinWidth="96" Content="{TemplateBinding AffirmativeText}" IsDefault="True" />
                                    </StackPanel>
                                    <ContentPresenter TextElement.Foreground="{DynamicResource Nocturne.Brushes.Text.Label}">
                                        <ContentPresenter.Resources>
                                            <!-- A plain message wraps -->
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="NegativeText" Value="{x:Null}">
                            <Setter TargetName="PART_Negative" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.96" To="1" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.96" To="1" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Flyout">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="FontFamily" Value="{DynamicResource Nocturne.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Nocturne.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nocturne.Brushes.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nocturne.Brushes.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,18,22,22" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Flyout">
                    <Grid>
                        <Border Margin="1" CornerRadius="14" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <Grid>
                                <Border CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Nocturne.Brushes.Surface1.Highlight}" />
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                        <Button x:Name="PART_Close" DockPanel.Dock="Right" Width="32" Height="32" Margin="12,0,-8,0" VerticalAlignment="Center"
                                                Style="{DynamicResource Nocturne.Styles.Button.Icon.Subtle}" ToolTip="Close" AutomationProperties.Name="Close">
                                            <c:StrokeIcon Width="16" Height="16" StrokeThickness="1.8" Data="{DynamicResource Nocturne.Icons.Close}" />
                                        </Button>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                          TextElement.FontSize="{DynamicResource Nocturne.Font.Size.Subtitle}" TextElement.FontWeight="SemiBold" />
                                    </DockPanel>
                                    <ContentPresenter />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Position" Value="Left">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Trigger>
            <Trigger Property="Position" Value="Top">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
            <Trigger Property="Position" Value="Bottom">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
