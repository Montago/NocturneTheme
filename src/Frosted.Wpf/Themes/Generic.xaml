<!--
    Theme dictionary: default styles for the Frosted controls (including classes derived from
    FrostedWindow, which implicit styles do not reach).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Frosted.Wpf;component/Styles/Frosted.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
