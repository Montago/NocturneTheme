<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Frosted.Wpf</RootNamespace>
    <AssemblyName>Frosted.Wpf</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package. A release workflow can override Version from the git tag (v1.2.3 -> 1.2.3). -->
  <PropertyGroup>
    <PackageId>Frosted.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Authors>Martin Kirk</Authors>
    <Copyright>Copyright (c) 2026 Martin Kirk</Copyright>
    <Description>Frosted Glass: a dark, frosted-glass theme for WPF on .NET 8+. Windows 11 Acrylic, Mica or Mica Alt shows through a tinted window, with glass cards and styles for the standard controls.</Description>
    <PackageTags>wpf;theme;mica;acrylic;glass;frosted;dark;controls;styles</PackageTags>
    <PackageProjectUrl>https://github.com/Montago/FrostedWpfTheme</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Montago/FrostedWpfTheme</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
