<!--
    Button, RepeatButton, ToggleButton.
    Default (secondary): a light glass fill. Variants: Frosted.Styles.Button.Primary (accent),
    .Subtle (no fill until hovered), .Icon and .Icon.Subtle (36 x 36, for a StrokeIcon).
    The background fades to ControlHelper.HoverBackground in 120 ms.
    DropDownButton (a chevron after the content; opens its Menu) and SplitButton (a main part and
    a chevron part), each also as .Primary. Tile: a large glass button with an icon, a count and a
    title (.Accent fills it with the accent).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Frosted.Wpf.Controls"
                    xmlns:h="clr-namespace:Frosted.Wpf.Helpers">

    <ControlTemplate x:Key="Frosted.Templates.Button" TargetType="ButtonBase">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <!-- Shadow sits on its own layer so the text keeps its rendering -->
            <Border x:Name="Shadow" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="Black" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                </Border.Effect>
            </Border>
            <Border x:Name="Bg" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}" />
            <Border x:Name="HoverBg" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding h:ControlHelper.HoverBackground}" Opacity="0" />
            <Border x:Name="PressedBg" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding h:ControlHelper.PressedBackground}" Visibility="Collapsed" />
            <Border x:Name="Highlight" Margin="1" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,1,0,0"
                    BorderBrush="{TemplateBinding h:ControlHelper.HighlightBrush}" />
            <Border x:Name="Outline" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <DockPanel x:Name="Content" Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <c:StrokeIcon x:Name="Chevron" DockPanel.Dock="Right" Width="14" Height="14" Margin="8,0,-2,0" StrokeThickness="2" Visibility="Collapsed"
                              Data="{DynamicResource Frosted.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter Focusable="False" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="h:ControlHelper.HasShadow" Value="True">
                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="h:ControlHelper.ShowChevron" Value="True">
                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Primary}" />
                <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Primary.Hover}" />
                <Setter TargetName="PressedBg" Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Primary.Pressed}" />
                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Border}" />
                <Setter TargetName="Highlight" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Highlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedBg" Property="Visibility" Value="Visible" />
                <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Content" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Frosted.Styles.Button" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Button.Secondary.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="h:ControlHelper.HoverBackground" Value="{DynamicResource Frosted.Brushes.Button.Secondary.Hover}" />
        <Setter Property="h:ControlHelper.PressedBackground" Value="{DynamicResource Frosted.Brushes.Button.Secondary.Pressed}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Frosted.Templates.Button}" />
    </Style>

    <Style x:Key="Frosted.Styles.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Frosted.Styles.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Border}" />
        <Setter Property="h:ControlHelper.HoverBackground" Value="{DynamicResource Frosted.Brushes.Button.Primary.Hover}" />
        <Setter Property="h:ControlHelper.PressedBackground" Value="{DynamicResource Frosted.Brushes.Button.Primary.Pressed}" />
        <Setter Property="h:ControlHelper.HighlightBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Highlight}" />
        <Setter Property="h:ControlHelper.HasShadow" Value="True" />
    </Style>

    <Style x:Key="Frosted.Styles.Button.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Frosted.Styles.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="h:ControlHelper.HoverBackground" Value="{DynamicResource Frosted.Brushes.Button.Subtle.Hover}" />
        <Setter Property="h:ControlHelper.PressedBackground" Value="{DynamicResource Frosted.Brushes.Surface.Pressed}" />
    </Style>

    <Style x:Key="Frosted.Styles.Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Frosted.Styles.Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Frosted.Styles.Button.Icon.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Frosted.Styles.Button.Subtle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Frosted.Styles.Button}" />
    <Style TargetType="RepeatButton" BasedOn="{StaticResource Frosted.Styles.Button}" />
    <!-- A checked ToggleButton takes the primary look -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Frosted.Styles.Button}" />

    <!-- The buttons ToolBar gives its children: subtle, 32px high, at least square -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource Frosted.Styles.Button.Subtle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource Frosted.Styles.Button.Subtle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- DropDownButton: the button with a chevron after its content -->
    <Style TargetType="c:DropDownButton" BasedOn="{StaticResource Frosted.Styles.Button}">
        <Setter Property="h:ControlHelper.ShowChevron" Value="True" />
        <Setter Property="Padding" Value="16,0,12,0" />
    </Style>
    <Style x:Key="Frosted.Styles.DropDownButton.Primary" TargetType="c:DropDownButton" BasedOn="{StaticResource Frosted.Styles.Button.Primary}">
        <Setter Property="h:ControlHelper.ShowChevron" Value="True" />
        <Setter Property="Padding" Value="16,0,12,0" />
    </Style>

    <!-- SplitButton: the main part and the chevron part light up on their own, a hairline between them -->
    <Style x:Key="Frosted.Styles.SplitButton.Arrow" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="34" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="AutomationProperties.Name" Value="More options" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border CornerRadius="0,8,8,0" Background="{TemplateBinding Background}" />
                        <Border x:Name="Over" CornerRadius="0,8,8,0" Background="{DynamicResource Frosted.Brushes.Button.Subtle.Hover}" Opacity="0" />
                        <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Frosted.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Over" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Over" Property="Opacity" Value="1" />
                            <Setter TargetName="Over" Property="Background" Value="{DynamicResource Frosted.Brushes.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Frosted.Templates.SplitButton" TargetType="c:SplitButton">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Shadow" CornerRadius="8" Background="Black" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                </Border.Effect>
            </Border>
            <DockPanel>
                <ToggleButton x:Name="PART_Arrow" DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.SplitButton.Arrow}"
                              Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" />
                <Border DockPanel.Dock="Right" Width="1" Margin="0,8" Background="{TemplateBinding BorderBrush}" />
                <Grid x:Name="Main" Background="Transparent">
                    <Border x:Name="Bg" CornerRadius="8,0,0,8" Background="{TemplateBinding Background}" />
                    <Border x:Name="HoverBg" CornerRadius="8,0,0,8" Background="{TemplateBinding h:ControlHelper.HoverBackground}" Opacity="0" />
                    <Border x:Name="PressedBg" CornerRadius="8,0,0,8" Background="{TemplateBinding h:ControlHelper.PressedBackground}" Visibility="Collapsed" />
                    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" Focusable="False" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </DockPanel>
            <Border Margin="1" CornerRadius="8" BorderThickness="0,1,0,0" BorderBrush="{TemplateBinding h:ControlHelper.HighlightBrush}" IsHitTestVisible="False" />
            <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="h:ControlHelper.HasShadow" Value="True">
                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="Main" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedBg" Property="Visibility" Value="Visible" />
                <Setter TargetName="Content" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="c:SplitButton" BasedOn="{StaticResource Frosted.Styles.Button}">
        <Setter Property="Template" Value="{StaticResource Frosted.Templates.SplitButton}" />
    </Style>
    <Style x:Key="Frosted.Styles.SplitButton.Primary" TargetType="c:SplitButton" BasedOn="{StaticResource Frosted.Styles.Button.Primary}">
        <Setter Property="Template" Value="{StaticResource Frosted.Templates.SplitButton}" />
    </Style>

    <!-- Tile: icon (Content) top left, Count top right, Title at the bottom -->
    <Style x:Key="Frosted.Styles.Tile" TargetType="c:Tile">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Surface1.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="h:ControlHelper.HoverBackground" Value="{DynamicResource Frosted.Brushes.Button.Secondary.Hover}" />
        <Setter Property="h:ControlHelper.HighlightBrush" Value="{DynamicResource Frosted.Brushes.Surface1.Highlight}" />
        <Setter Property="Width" Value="160" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Tile">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Shadow" CornerRadius="14" Background="Black" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.3" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14" Background="{TemplateBinding Background}" />
                        <Border x:Name="HoverBg" CornerRadius="14" Background="{TemplateBinding h:ControlHelper.HoverBackground}" Opacity="0" />
                        <Border Margin="1" CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{TemplateBinding h:ControlHelper.HighlightBrush}" />
                        <Border CornerRadius="14" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <ContentPresenter x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{TemplateBinding Count}"
                                              TextElement.FontSize="26" TextElement.FontWeight="SemiBold" />
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{TemplateBinding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.HasShadow" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Count" Value="{x:Null}">
                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="Opacity" Value="0.85" />
                            <Setter TargetName="HoverBg" Property="Background" Value="{Binding (h:ControlHelper.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="c:Tile" BasedOn="{StaticResource Frosted.Styles.Tile}" />
    <Style x:Key="Frosted.Styles.Tile.Accent" TargetType="c:Tile" BasedOn="{StaticResource Frosted.Styles.Tile}">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Border}" />
        <Setter Property="h:ControlHelper.HoverBackground" Value="{DynamicResource Frosted.Brushes.Button.Primary.Hover}" />
        <Setter Property="h:ControlHelper.HighlightBrush" Value="{DynamicResource Frosted.Brushes.Button.Primary.Highlight}" />
        <Setter Property="h:ControlHelper.HasShadow" Value="True" />
    </Style>
</ResourceDictionary>
