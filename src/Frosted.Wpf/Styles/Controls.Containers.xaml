<!--
    GroupBox, Expander and TabControl. The default TabControl is a segmented control (tabs share
    a sunken strip, the selected one has a light fill and a short accent bar).
    Frosted.Styles.TabControl.Document gives browser-like document tabs with close buttons
    (TabHelper.ShowCloseButton), badges (TabHelper.Badge) and a "+" button (TabHelper.ShowAddButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Frosted.Wpf.Controls"
                    xmlns:h="clr-namespace:Frosted.Wpf.Helpers">

    <BorderGapMaskConverter x:Key="Frosted.Converters.BorderGapMask" />

    <!-- GroupBox: a sunken frame with the header sitting in a gap in its top edge -->
    <Style TargetType="GroupBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,6,16,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="10" Background="{TemplateBinding Background}" />
                        <Border x:Name="Header" Grid.Column="1" Grid.RowSpan="2" Padding="6,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontSize="{DynamicResource Frosted.Font.Size.Caption}" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ContentPresenter Grid.Row="2" Grid.ColumnSpan="4" Margin="{TemplateBinding Padding}" />
                        <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.OpacityMask>
                                <MultiBinding Converter="{StaticResource Frosted.Converters.BorderGapMask}" ConverterParameter="10">
                                    <Binding ElementName="Header" Path="ActualWidth" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander: a 48px glass header with a chevron that turns in 150 ms; content below it -->
    <Style x:Key="Frosted.Styles.Expander.Header" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource Frosted.Brushes.Expander.Header}" />
                        <Border x:Name="HoverBg" CornerRadius="10" Background="{DynamicResource Frosted.Brushes.Expander.Header.Hover}" Opacity="0" />
                        <DockPanel Margin="14,0">
                            <c:StrokeIcon x:Name="Chevron" DockPanel.Dock="Right" Width="16" Height="16" StrokeThickness="1.8"
                                          Data="{DynamicResource Frosted.Icons.ChevronDown}" Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                <c:StrokeIcon.RenderTransform>
                                    <RotateTransform />
                                </c:StrokeIcon.RenderTransform>
                            </c:StrokeIcon>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Padding" Value="14,14,14,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel x:Name="Root">
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Style="{StaticResource Frosted.Styles.Expander.Header}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" />
                        <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}" Visibility="Collapsed" Focusable="False" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Segmented TabControl. Header fonts and colours sit on the header presenter, not on the
        TabItem, so the page content does not inherit them.
    -->
    <Style TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" Height="36" SnapsToDevicePixels="True">
                        <Border x:Name="HoverBg" CornerRadius="8" Background="{DynamicResource Frosted.Brushes.Item.Hover}" Opacity="0" />
                        <Border x:Name="SelectedBg" CornerRadius="8" Background="{DynamicResource Frosted.Brushes.Item.Selected}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" Margin="14,0" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="{DynamicResource Frosted.Font.Size.Default}" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource Frosted.Brushes.Tab.Text}" />
                        <Border x:Name="Indicator" Width="16" Height="3" Margin="0,0,0,3" CornerRadius="1.5" VerticalAlignment="Bottom"
                                Background="{DynamicResource Frosted.Brushes.Accent.Light}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverBg" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Frosted.Brushes.Text.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Padding" Value="4,16,4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="10" Padding="2,4" Background="{DynamicResource Frosted.Brushes.TabStrip}"
                                BorderBrush="{DynamicResource Frosted.Brushes.TabStrip.Border}" BorderThickness="1">
                            <UniformGrid x:Name="HeaderPanel" Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"
                                          KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Document tabs -->
    <Style x:Key="Frosted.Styles.TabItem.CloseButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="{DynamicResource Frosted.Icons.Close}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Row.Selected}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Item.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Frosted.Styles.TabItem.Document" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Height="36" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="8,8,0,0" Background="Transparent" />
                        <Border x:Name="Line" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Frosted.Brushes.Stroke}" />
                        <Border x:Name="Frame" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Frosted.Brushes.Stroke}" Visibility="Collapsed" />
                        <Rectangle x:Name="Separator" Width="1" Margin="0,10" HorizontalAlignment="Left" Fill="{DynamicResource Frosted.Brushes.Stroke}" Visibility="Collapsed" />
                        <DockPanel x:Name="HeaderRow" Margin="12,0,4,0" TextElement.Foreground="{DynamicResource Frosted.Brushes.Text.Label}">
                            <Button x:Name="CloseButton" DockPanel.Dock="Right" Margin="4,0,0,0" Visibility="Collapsed" Style="{StaticResource Frosted.Styles.TabItem.CloseButton}"
                                    Command="{x:Static h:TabHelper.CloseTabCommand}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="Close" />
                            <ContentControl x:Name="Badge" DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Content="{TemplateBinding h:TabHelper.Badge}" Style="{DynamicResource Frosted.Styles.Badge}" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.FontSize="{DynamicResource Frosted.Font.Size.Caption}" TextElement.FontWeight="SemiBold" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:TabHelper.ShowCloseButton" Value="True">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:TabHelper.ShowCloseButton" Value="False">
                            <Setter TargetName="HeaderRow" Property="Margin" Value="12,0" />
                        </Trigger>
                        <Trigger Property="h:TabHelper.ShowSeparator" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:TabHelper.Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Frosted.Brushes.DocumentTab.Hover}" />
                            <Setter TargetName="HeaderRow" Property="TextElement.Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Root" Property="Height" Value="40" />
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Frosted.Brushes.DocumentTab.Selected}" />
                            <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Frame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderRow" Property="TextElement.Foreground" Value="{DynamicResource Frosted.Brushes.Text.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Frosted.Styles.TabItem.AddButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="ToolTip" Value="New tab" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <c:StrokeIcon Width="16" Height="16" StrokeThickness="2" Data="{DynamicResource Frosted.Icons.Plus}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Row.Selected}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Item.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Frosted.Styles.TabControl.Document" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Padding" Value="17" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Frosted.Styles.TabItem.Document}" />
        <Setter Property="h:TabHelper.TracksSeparators" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" VerticalAlignment="Bottom" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <!-- The strip's bottom line stops 10px short so the panel's rounded corner can meet it -->
                            <Border Grid.Column="1" Height="36" Margin="0,0,10,0" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Frosted.Brushes.Stroke}">
                                <Button x:Name="AddButton" Margin="4,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                        Style="{StaticResource Frosted.Styles.TabItem.AddButton}" Command="{x:Static h:TabHelper.AddTabCommand}" />
                            </Border>
                        </Grid>
                        <c:TabPanelBorder Grid.Row="1" CornerRadius="10" Background="{DynamicResource Frosted.Brushes.DocumentTab.Selected}"
                                          BorderBrush="{DynamicResource Frosted.Brushes.Stroke}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"
                                              KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" />
                        </c:TabPanelBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:TabHelper.ShowAddButton" Value="True">
                            <Setter TargetName="AddButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
