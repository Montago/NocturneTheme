<!--
    Shared pieces: the keyboard focus ring, typography, cards, tags, status pills, badges, icon
    tiles and StrokeIcon. Other files reach these with DynamicResource (StaticResource does not
    work across the merged files).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Frosted.Wpf.Controls">

    <!-- Keyboard focus: a 2px white ring, 2px outside the control -->
    <Style x:Key="Frosted.Styles.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="11" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource Frosted.Brushes.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyboard focus inside a popup (combo box options, menu items): the ring sits on the item's edge -->
    <Style x:Key="Frosted.Styles.FocusVisual.Inset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="6" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource Frosted.Brushes.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:StrokeIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StrokeIcon">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typography -->
    <Style x:Key="Frosted.Styles.TextBlock.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <!-- Section label: write it in capitals -->
    <Style x:Key="Frosted.Styles.TextBlock.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Small}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.ListTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.ListTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Label}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Hint}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Error" TargetType="TextBlock" BasedOn="{StaticResource Frosted.Styles.TextBlock.Hint}">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Error.Text}" />
    </Style>
    <Style x:Key="Frosted.Styles.TextBlock.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Tag}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Secondary}" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Accent.Text}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Accent.Text.Hover}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass card: a plain Border -->
    <Style x:Key="Frosted.Styles.Border.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Surface1.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!--
        Glass card with a section label (Header) and an optional tag on the right (Tag):
        <HeaderedContentControl Style="{StaticResource Frosted.Styles.Card}" Header="BUTTON" Tag="Button · RepeatButton">
    -->
    <Style x:Key="Frosted.Styles.Card" TargetType="HeaderedContentControl">
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Surface1.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Frosted.Brushes.Surface1.Highlight}" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <DockPanel x:Name="HeaderRow" DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <ContentControl x:Name="TagChip" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{TemplateBinding Tag}"
                                                    Style="{DynamicResource Frosted.Styles.Tag}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontSize="{DynamicResource Frosted.Font.Size.Small}" TextElement.FontWeight="Bold" />
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="TagChip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tag: small monospaced chip naming the WPF class, as on the cards -->
    <Style x:Key="Frosted.Styles.Tag" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Tag}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Hint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Stroke}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pills: Success, Warning, Error -->
    <Style x:Key="Frosted.Styles.Pill" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Success}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Success.Background}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Frosted.Styles.Pill.Success" TargetType="ContentControl" BasedOn="{StaticResource Frosted.Styles.Pill}" />
    <Style x:Key="Frosted.Styles.Pill.Warning" TargetType="ContentControl" BasedOn="{StaticResource Frosted.Styles.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Warning.Background}" />
    </Style>
    <Style x:Key="Frosted.Styles.Pill.Error" TargetType="ContentControl" BasedOn="{StaticResource Frosted.Styles.Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Error.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Error.Background}" />
    </Style>

    <!-- Badge: a small count, e.g. on a document tab -->
    <Style x:Key="Frosted.Styles.Badge" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Tag}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Warning.Background}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Icon tile: a rounded square around a StrokeIcon. Inside a selected ListBoxItem it turns
        accent green.
    -->
    <Style x:Key="Frosted.Styles.IconTile" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Tile}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Tile.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Tile.Icon}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Tile.Border.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Frosted.Styles.IconTile.Small" TargetType="ContentControl" BasedOn="{StaticResource Frosted.Styles.IconTile}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>
</ResourceDictionary>
