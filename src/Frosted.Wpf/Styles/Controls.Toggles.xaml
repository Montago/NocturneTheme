<!--
    CheckBox (with IsThreeState), RadioButton and the toggle switch
    (Frosted.Styles.ToggleSwitch, for CheckBox or ToggleButton: content on the left, switch on the right).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Frosted.Wpf.Controls">

    <Style x:Key="Frosted.Styles.Toggle.Base" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Frosted.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Toggle.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Toggle.Border}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Frosted.Styles.Toggle.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="5" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <c:StrokeIcon x:Name="Check" Width="14" Height="14" StrokeThickness="3" Visibility="Collapsed"
                                          Data="{DynamicResource Frosted.Icons.Check}" Foreground="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
                            <Rectangle x:Name="Dash" Width="10" Height="2" RadiusX="1" RadiusY="1" Visibility="Collapsed" Fill="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Toggle.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource Frosted.Styles.Toggle.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Checked: a 6px accent ring around a white centre -->
                        <Ellipse x:Name="Dot" Width="20" Height="20" VerticalAlignment="Center" StrokeThickness="1"
                                 Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Frosted.Brushes.Toggle.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="6" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Toggle switch for a CheckBox or ToggleButton: content on the left, the 40 x 20 switch on
        the right; the knob slides in 150 ms.
    -->
    <Style x:Key="Frosted.Styles.ToggleSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Frosted.Styles.Toggle.Base}">
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Switch.Border}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="IsThreeState" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <DockPanel x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="Switch" DockPanel.Dock="Right" Width="40" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource Frosted.Brushes.Switch.Knob}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Switch" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Toggle.Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Frosted.Brushes.Text.OnAccent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Knob" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
