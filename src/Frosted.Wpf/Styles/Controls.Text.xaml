<!--
    TextBox, PasswordBox, RichTextBox, Label. A field is a dark, slightly sunken glass strip with a lighter
    bottom edge; keyboard focus draws a 2px accent line along the bottom, an error a red one.
    ControlHelper.Placeholder shows hint text, ControlHelper.Icon an icon on the left
    (Frosted.Styles.TextBox.Search sets the magnifier), PasswordBoxHelper.CanReveal an eye button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Frosted.Wpf.Controls"
                    xmlns:h="clr-namespace:Frosted.Wpf.Helpers"
                    xmlns:fg="urn:frosted-wpf">

    <!-- The look comes from the template; keep WPF's red adorner away -->
    <ControlTemplate x:Key="Frosted.Templates.NoErrorAdorner">
        <AdornedElementPlaceholder />
    </ControlTemplate>

    <Style x:Key="Frosted.Styles.Field.Base" TargetType="Control">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource Frosted.Brushes.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Field.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Frosted.Templates.NoErrorAdorner}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Frosted.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Frosted.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Frosted.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Frosted.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <c:StrokeIcon x:Name="Icon" DockPanel.Dock="Left" Width="16" Height="16" Margin="11,0,-4,0" StrokeThickness="2"
                                          Data="{TemplateBinding h:ControlHelper.Icon}" Foreground="{DynamicResource Frosted.Brushes.Text.Hint}" />
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Frosted.Brushes.Text.Placeholder}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:ControlHelper.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search field: magnifier on the left -->
    <Style x:Key="Frosted.Styles.TextBox.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="h:ControlHelper.Icon" Value="{DynamicResource Frosted.Icons.Search}" />
    </Style>

    <!-- Multi-line text: text from the top, wraps, scrolls -->
    <Style x:Key="Frosted.Styles.TextBox.MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- The eye button of a PasswordBox -->
    <Style x:Key="Frosted.Styles.ToggleButton.Reveal" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="ToolTip" Value="Show password" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <c:StrokeIcon Width="18" Height="18" Data="{DynamicResource Frosted.Icons.Eye}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Button.Subtle.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Item.Selected}" />
                            <Setter Property="ToolTip" Value="Hide password" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource Frosted.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Frosted.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="h:PasswordBoxHelper.IsMonitoring" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Frosted.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Frosted.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <DockPanel Margin="{TemplateBinding BorderThickness}">
                            <ToggleButton x:Name="Reveal" DockPanel.Dock="Right" Style="{StaticResource Frosted.Styles.ToggleButton.Reveal}" Visibility="Collapsed"
                                          IsChecked="{Binding (fg:PasswordBoxHelper.IsRevealed), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:ControlHelper.Placeholder}" Foreground="{DynamicResource Frosted.Brushes.Text.Placeholder}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <TextBlock x:Name="Revealed" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                           Text="{TemplateBinding h:PasswordBoxHelper.RevealedText}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="h:PasswordBoxHelper.CanReveal" Value="True">
                            <Setter TargetName="Reveal" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:PasswordBoxHelper.IsRevealed" Value="True">
                            <Setter TargetName="Revealed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="h:PasswordBoxHelper.HasPassword" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Frosted.Brushes.Text.Label}" />
        <Setter Property="Padding" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The TextBox ToolBar gives its children -->
    <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!--
        RichTextBox: the multi-line field. A FlowDocument does not take the box's font (it would be
        justified Georgia), so the document gets the theme font, left-aligned, and paragraphs 8px
        apart instead of a blank line.
    -->
    <Style TargetType="RichTextBox" BasedOn="{StaticResource Frosted.Styles.Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Frosted.Brushes.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Frosted.Brushes.Accent.Light}" />
        <Setter Property="SelectionOpacity" Value="0.45" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="BottomLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Frosted.Brushes.Field.Border.Bottom}" />
                        <Border x:Name="FocusLine" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" BorderThickness="0,0,0,2"
                                BorderBrush="{DynamicResource Frosted.Brushes.Accent.Light}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding BorderThickness}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Frosted.Brushes.Field.Focus}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Field.Border.Focus}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="h:ControlHelper.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource Frosted.Brushes.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="FlowDocument">
                <Setter Property="FontFamily" Value="{DynamicResource Frosted.Fonts.Family}" />
                <Setter Property="FontSize" Value="{DynamicResource Frosted.Font.Size.Default}" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="PagePadding" Value="0" />
            </Style>
            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
